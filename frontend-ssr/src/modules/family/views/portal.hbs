<div class="py-8 bg-slate-50 min-h-[calc(100vh-4rem)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

    <!-- Header & Welcome Banner -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 mb-2">
            <span>👨‍👩‍👧</span> Cổng Hộ Gia Đình & Người Giám Hộ
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Quản Lý Hồ Sơ Chiến Binh Nhí & Kho Kỷ Niệm
          </h1>
          <p class="mt-1 text-xs sm:text-sm text-slate-600">
            Xin chào phụ huynh <strong>{{formatDisplayName user}}</strong> ({{user.email}}). Nơi gia đình cập nhật nhật ký, gửi lời ru yêu thương và quản lý ảnh/video cho con.
          </p>
        </div>

        <div class="flex items-center gap-2">
          <button 
            type="button" 
            onclick="document.getElementById('profile-settings-card').classList.toggle('hidden')"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors"
          >
            <span>⚙️</span> Cài đặt danh xưng
          </button>
          <a href="/warriors" class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
            <span>🌐</span> Xem trang công khai
          </a>
        </div>
      </div>
    </div>

    <!-- Flash Notifications -->
    {{#if flashMessage}}
      <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-start gap-2 shadow-sm">
        <span class="text-base">✓</span>
        <div>{{flashMessage}}</div>
      </div>
    {{/if}}

    {{#if errorMessage}}
      <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold flex items-start gap-2 shadow-sm">
        <span class="text-base">✕</span>
        <div>{{errorMessage}}</div>
      </div>
    {{/if}}

    <!-- Profile & Identity Preferences Card (Tùy chọn danh xưng, giới tính & hiển thị) -->
    <div id="profile-settings-card" class="hidden bg-white rounded-2xl border border-amber-200/80 shadow-sm p-6 sm:p-8 space-y-5">
      <div class="flex items-center justify-between pb-3 border-b border-slate-100">
        <div>
          <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <span>⚙️</span> Cài Đặt Danh Xưng & Tùy Chọn Hiển Thị Phụ Huynh
          </h3>
          <p class="text-xs text-slate-500 mt-0.5">
            Phân định danh tính rõ ràng giữa Họ, Tên đệm, Tên gọi, Giới tính xưng hô và quan hệ đối với con.
          </p>
        </div>
        <button type="button" onclick="document.getElementById('profile-settings-card').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 font-bold text-sm">✕ Đóng</button>
      </div>

      <form action="/family/profile/update" method="POST" class="space-y-4">
        <!-- Live Preview Banner -->
        <div class="p-3.5 rounded-xl bg-amber-50/70 border border-amber-200 text-xs">
          <div class="text-[11px] font-semibold text-amber-800 uppercase tracking-wider mb-1">Xem trước cách hiển thị danh xưng thực tế:</div>
          <div class="flex flex-wrap items-center gap-4 text-xs font-medium">
            <div>🇻🇳 Tiếng Việt: <span id="family_preview_vi" class="font-bold text-slate-900">{{formatDisplayName user}}</span></div>
            <div>🇬🇧 English: <span id="family_preview_en" class="font-bold text-slate-900">{{formatDisplayName user}}</span></div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <!-- Gender -->
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Giới tính & Tiền tố</label>
            <select id="f_gender" name="gender" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium">
              <option value="MALE" {{#if (eq user.gender "MALE")}}selected{{/if}}>Nam (Ông / Anh - Mr.)</option>
              <option value="FEMALE" {{#if (eq user.gender "FEMALE")}}selected{{/if}}>Nữ (Bà / Chị - Mrs./Ms.)</option>
              <option value="OTHER" {{#if (eq user.gender "OTHER")}}selected{{/if}}>Khác (Mx.)</option>
              <option value="UNSPECIFIED" {{#if (eq user.gender "UNSPECIFIED")}}selected{{/if}}>Không xác định</option>
            </select>
          </div>

          <!-- Title Prefix -->
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Học hàm / Danh xưng phụ</label>
            <input type="text" id="f_title_prefix" name="title_prefix" value="{{user.title_prefix}}" placeholder="VD: ThS., BS., KS." class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500" />
          </div>

          <!-- Family Relation -->
          <div class="sm:col-span-2">
            <label class="block text-xs font-medium text-slate-700 mb-1">Quan hệ với bé *</label>
            <input type="text" id="f_family_relation" name="family_relation" value="{{user.family_relation}}" placeholder="VD: Bố, Mẹ, Ông nội, Bà ngoại, Người giám hộ..." class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- Last Name -->
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Họ *</label>
            <input type="text" id="f_last_name" name="last_name" required value="{{user.last_name}}" placeholder="Nguyễn" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500" />
          </div>

          <!-- Middle Name -->
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Tên đệm</label>
            <input type="text" id="f_middle_name" name="middle_name" value="{{user.middle_name}}" placeholder="Văn" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500" />
          </div>

          <!-- First Name -->
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Tên gọi *</label>
            <input type="text" id="f_first_name" name="first_name" required value="{{user.first_name}}" placeholder="An" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Display Mode -->
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Chế độ hiển thị tên</label>
            <select id="f_display_mode" name="display_mode" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium">
              <option value="FULL_NAME" {{#if (eq user.display_mode "FULL_NAME")}}selected{{/if}}>Họ và tên đầy đủ (VD: Nguyễn Văn An)</option>
              <option value="FIRST_ONLY" {{#if (eq user.display_mode "FIRST_ONLY")}}selected{{/if}}>Chỉ tên gọi thân mật (VD: An)</option>
              <option value="LAST_FIRST" {{#if (eq user.display_mode "LAST_FIRST")}}selected{{/if}}>Họ và Tên rút gọn (VD: Nguyễn An)</option>
              <option value="INITIALS" {{#if (eq user.display_mode "INITIALS")}}selected{{/if}}>Tên viết tắt (VD: N. V. A)</option>
              <option value="ANONYMOUS" {{#if (eq user.display_mode "ANONYMOUS")}}selected{{/if}}>Ẩn danh (Phụ huynh bé)</option>
            </select>
          </div>

          <!-- Phone Number -->
          <div>
            <label class="block text-xs font-medium text-slate-700 mb-1">Số điện thoại phụ huynh</label>
            <input type="tel" name="phone_number" value="{{user.phone_number}}" placeholder="0988xxxxxx" class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-500" />
          </div>
        </div>

        <div class="flex justify-end pt-2">
          <button type="submit" class="inline-flex items-center gap-2 px-5 py-2 text-xs font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-sm transition-all">
            <span>💾 Lưu Thông Tin Xưng Hô</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Legal Framework Banner -->
    <div class="p-4 rounded-xl bg-sky-50 border border-sky-200 text-sky-900 text-xs flex items-start gap-3">
      <span class="text-lg">⚖️</span>
      <div class="leading-relaxed">
        <strong>Bảo đảm quyền riêng tư trẻ em theo Pháp luật Việt Nam:</strong> Căn cứ <em>Điều 33 Luật Trẻ em 2016</em> và <em>Nghị định 13/2023/NĐ-CP</em>, phụ huynh có toàn quyền sửa đổi thông tin, tải khoảnh khắc gia đình và thực thi <strong>quyền rút hồ sơ khẩn cấp (Emergency Unpublish)</strong> bất kỳ thời điểm nào.
      </div>
    </div>

    <!-- Children List Section -->
    <div class="space-y-8">
      <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
        <span>🌟</span> Danh Sách Hồ Sơ Con Quản Lý ({{myChildren.length}})
      </h2>

      {{#if myChildren.length}}
        {{#each myChildren}}
          <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8 space-y-6">
            
            <!-- Child Status Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="text-xl font-bold text-slate-900">{{this.full_name}}</h3>
                  {{#if this.nickname}}
                    <span class="text-sm font-semibold text-rose-600">({{this.nickname}})</span>
                  {{/if}}
                </div>
                
                <div class="flex flex-wrap items-center gap-2 text-xs">
                  <!-- Published Status -->
                  {{#if this.is_published}}
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-semibold bg-emerald-100 text-emerald-800">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      Đang hiển thị công khai
                    </span>
                  {{else}}
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-semibold bg-rose-100 text-rose-800">
                      <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
                      Đã ẩn an toàn (Quyền được quên)
                    </span>
                  {{/if}}

                  <!-- Medical Status -->
                  <span class="px-2.5 py-0.5 rounded-full font-medium bg-slate-100 text-slate-700">
                    Trạng thái: {{this.status}}
                  </span>

                  <!-- Candles -->
                  <span class="px-2.5 py-0.5 rounded-full font-medium bg-amber-50 text-amber-800 border border-amber-200">
                    🕯️ {{this.candle_count}} ngọn nến
                  </span>
                </div>
              </div>

              {{#if this.is_published}}
                <a
                  href="/warriors/{{this.slug}}"
                  target="_blank"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-xl transition-colors"
                >
                  Xem trang công khai ↗
                </a>
              {{/if}}
            </div>

            <!-- Update Story Form -->
            <div class="space-y-4">
              <h4 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                <span>✏️</span> Cập Nhật Nhật Ký & Ước Mơ Của Bé
              </h4>

              <form action="/family/update/{{this.id}}" method="POST" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">Biệt danh ở nhà</label>
                    <input
                      type="text"
                      name="nickname"
                      value="{{this.nickname}}"
                      placeholder="Ví dụ: Bé Bơ, Heo Con..."
                      class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white"
                    />
                  </div>

                  <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">Tóm tắt ước mơ của bé</label>
                    <input
                      type="text"
                      name="dream_summary"
                      value="{{this.dream_summary}}"
                      placeholder="Ví dụ: Ước mơ trở thành họa sĩ vẽ tranh..."
                      class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-medium text-slate-700 mb-1">Nhật ký điều trị mới (Tin vui, tiến triển sức khỏe)</label>
                  <textarea
                    name="story_html"
                    rows="3"
                    placeholder="Viết cập nhật mới về quá trình điều trị của con..."
                    class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white"
                  ></textarea>
                </div>

                <div class="flex justify-end">
                  <button
                    type="submit"
                    class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-sm transition-all"
                  >
                    <span>Lưu cập nhật nhật ký</span>
                  </button>
                </div>
              </form>
            </div>

            <!-- ========================================== -->
            <!-- 📸 KHO KỶ NIỆM CỦA CON (MEMORIAL MEDIA VAULT) -->
            <!-- ========================================== -->
            <div class="pt-5 border-t border-slate-100 space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <h4 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                    <span>📸</span> Kho Kỷ Niệm Của Con (Ảnh, Video & Kỷ Vật)
                  </h4>
                  <p class="text-[11px] text-slate-500">Lưu giữ những khoảnh khắc nụ cười, clip kỷ niệm và tranh vẽ đáng yêu của con.</p>
                </div>
                <button
                  type="button"
                  onclick="openMediaModal('{{this.id}}', '{{this.full_name}}')"
                  class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 rounded-xl transition-all shadow-sm"
                >
                  <span>+ Thêm Ảnh / Video Kỷ Niệm</span>
                </button>
              </div>

              <!-- Media Items Grid -->
              {{#if this.gallery.length}}
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                  {{#each this.gallery}}
                    <div class="group relative rounded-xl border border-slate-200 overflow-hidden bg-slate-50 flex flex-col shadow-sm">
                      <!-- Media Content Area -->
                      <div class="relative h-44 bg-slate-900 overflow-hidden flex items-center justify-center">
                        {{#if (eq this.media_type 'VIDEO')}}
                          {{#if (contains this.media_url 'youtube.com/embed')}}
                            <iframe 
                              src="{{this.media_url}}" 
                              title="{{this.caption}}" 
                              class="w-full h-full border-0" 
                              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                              allowfullscreen
                            ></iframe>
                          {{else}}
                            <video controls class="w-full h-full object-cover">
                              <source src="{{this.media_url}}" type="video/mp4">
                              Trình duyệt không hỗ trợ thẻ video.
                            </video>
                          {{/if}}
                        {{else if (eq this.media_type 'AUDIO')}}
                          <div class="p-4 w-full flex flex-col items-center justify-center bg-gradient-to-br from-indigo-900 to-slate-900 text-white">
                            <span class="text-3xl mb-2">🎵</span>
                            <audio controls class="w-full mt-2" src="{{this.media_url}}"></audio>
                          </div>
                        {{else}}
                          <img
                            src="{{this.media_url}}"
                            alt="{{this.caption}}"
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                            onerror="this.src='https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=600&auto=format&fit=crop&q=80'"
                          />
                        {{/if}}

                        <!-- Badge Type -->
                        <span class="absolute top-2 left-2 px-2 py-0.5 rounded text-[10px] font-bold bg-black/60 text-white backdrop-blur-sm uppercase">
                          {{#if (eq this.media_type 'VIDEO')}}🎬 Clip Video{{else if (eq this.media_type 'AUDIO')}}🎵 Âm thanh{{else if (eq this.media_type 'DRAWING')}}🎨 Tranh vẽ{{else}}🖼️ Hình ảnh{{/if}}
                        </span>
                      </div>

                      <!-- Caption & Actions -->
                      <div class="p-3 flex-1 flex flex-col justify-between bg-white">
                        <div class="text-xs font-semibold text-slate-800 line-clamp-2">
                          {{#if this.caption}}{{this.caption}}{{else}}Khoảnh khắc yêu thương{{/if}}
                        </div>

                        <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
                          <span class="text-slate-400">{{formatDate this.created_at}}</span>
                          <form 
                            action="/family/gallery/{{../this.id}}/{{this.id}}/delete" 
                            method="POST" 
                            onsubmit="return confirm('Bạn có chắc chắn muốn xóa kỷ vật này khỏi kho lưu trữ?');"
                          >
                            <button type="submit" class="text-rose-600 hover:text-rose-800 font-semibold transition-colors">
                              🗑️ Xóa
                            </button>
                          </form>
                        </div>
                      </div>
                    </div>
                  {{/each}}
                </div>
              {{else}}
                <div class="p-6 text-center bg-slate-50 rounded-xl border border-dashed border-slate-300 text-xs text-slate-500">
                  <span>📷</span> Bé chưa có ảnh hay video nào trong kho kỷ niệm. Phụ huynh hãy bấm <strong>"Thêm Ảnh / Video Kỷ Niệm"</strong> để lưu giữ từng khoảnh khắc tươi đẹp của con nhé!
                </div>
              {{/if}}
            </div>

            <!-- ========================================== -->
            <!-- 🎙️ LỜI RU & TIN NHẮN THOẠI YÊU THƯƠNG GỬI CON -->
            <!-- ========================================== -->
            <div class="pt-5 border-t border-slate-100 space-y-4">
              <div class="bg-gradient-to-r from-rose-50 via-amber-50 to-pink-50 p-5 rounded-2xl border border-rose-200/80 space-y-4">
                <div class="flex items-center gap-2">
                  <span class="text-2xl">🎙️</span>
                  <div>
                    <h4 class="text-sm font-bold text-rose-900">
                      Ghi Âm Lời Ru & Tin Nhắn Thoại Yêu Thương Gửi Con
                    </h4>
                    <p class="text-[11px] text-rose-700">
                      Thu âm giọng nói, lời hát ru hoặc lời tâm sự ấm áp của cha mẹ để lưu giữ mãi mãi bên trang tưởng niệm của bé.
                    </p>
                  </div>
                </div>

                <!-- Web Audio Voice Recorder Widget -->
                <div class="bg-white p-4 rounded-xl border border-rose-100 shadow-sm space-y-3">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                      <button
                        type="button"
                        id="rec_btn_{{this.id}}"
                        onclick="toggleRecording('{{this.id}}')"
                        class="inline-flex items-center gap-2 px-4 py-2 text-xs font-bold rounded-xl text-white bg-rose-600 hover:bg-rose-700 transition-all shadow-sm"
                      >
                        <span id="rec_icon_{{this.id}}" class="h-2.5 w-2.5 rounded-full bg-white"></span>
                        <span id="rec_label_{{this.id}}">Bắt đầu thu âm</span>
                      </button>

                      <div id="rec_timer_{{this.id}}" class="hidden font-mono text-xs font-bold text-rose-600 px-2.5 py-1 rounded bg-rose-50 border border-rose-200">
                        00:00
                      </div>

                      <div id="rec_wave_{{this.id}}" class="hidden items-center gap-0.5 h-4">
                        <span class="w-1 bg-rose-500 h-full animate-bounce"></span>
                        <span class="w-1 bg-rose-500 h-2/3 animate-bounce [animation-delay:0.1s]"></span>
                        <span class="w-1 bg-rose-500 h-4/5 animate-bounce [animation-delay:0.2s]"></span>
                        <span class="w-1 bg-rose-500 h-1/2 animate-bounce [animation-delay:0.3s]"></span>
                      </div>
                    </div>

                    <div id="rec_status_{{this.id}}" class="text-[11px] text-slate-500 italic">
                      Nhấn nút để bắt đầu thu âm qua Micro máy tính/điện thoại
                    </div>
                  </div>

                  <!-- Audio Preview Container -->
                  <div id="rec_preview_box_{{this.id}}" class="hidden pt-3 border-t border-slate-100 space-y-3">
                    <div class="text-xs font-semibold text-slate-700 flex items-center gap-1.5">
                      <span>🎧</span> Nghe lại bản thu âm:
                    </div>
                    <audio id="rec_audio_{{this.id}}" controls class="w-full"></audio>

                    <form action="/family/tributes/voice" method="POST" class="space-y-3">
                      <input type="hidden" name="child_id" value="{{this.id}}" />
                      <input type="hidden" id="rec_base64_{{this.id}}" name="base64Audio" value="" />
                      <input type="hidden" id="rec_duration_{{this.id}}" name="duration_seconds" value="0" />

                      <div>
                        <input
                          type="text"
                          name="content"
                          placeholder="Tiêu đề lời ru hoặc vài dòng tâm sự gửi con (VD: Lời ru ngọt ngào mẹ hát ru con ngủ...)"
                          class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500"
                        />
                      </div>

                      <div class="flex justify-end gap-2">
                        <button
                          type="button"
                          onclick="resetRecorder('{{this.id}}')"
                          class="px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100 rounded-lg"
                        >
                          Thu âm lại
                        </button>
                        <button
                          type="submit"
                          class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-gradient-to-r from-rose-600 to-pink-600 hover:from-rose-700 hover:to-pink-700 rounded-xl shadow-sm transition-all"
                        >
                          <span>💌 Lưu Lời Ru Gửi Con</span>
                        </button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>

            <!-- ========================================== -->
            <!-- 🌟 CÂY ĐIỀU ƯỚC CỦA CON -->
            <!-- ========================================== -->
            <div class="pt-5 border-t border-slate-100 space-y-4">
              <div class="flex items-center justify-between">
                <h4 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                  <span>🌟</span> Cây Điều Ước Của Con
                </h4>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800">
                  {{this.wishes.length}} điều ước
                </span>
              </div>

              <!-- Danh sách điều ước đã đăng ký -->
              {{#if this.wishes.length}}
                <div class="space-y-2">
                  {{#each this.wishes}}
                    <div class="p-3 rounded-xl border border-slate-200 bg-slate-50/70 flex items-center justify-between flex-wrap gap-2 text-xs">
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                          <span class="font-bold text-slate-900">{{this.title}}</span>
                          <span class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded bg-white text-slate-600 border border-slate-200">
                            {{this.category}}
                          </span>
                        </div>
                        {{#if this.description}}
                          <p class="text-[11px] text-slate-500 mt-0.5 italic">"{{this.description}}"</p>
                        {{/if}}
                        {{#if this.sponsor_name}}
                          <p class="text-[11px] text-blue-700 mt-0.5">
                            💌 Nhà hảo tâm nhận trao: <strong>{{this.sponsor_name}}</strong>
                          </p>
                        {{/if}}
                      </div>

                      <div class="flex items-center gap-3 shrink-0">
                        {{#if this.estimated_cost}}
                          <span class="font-mono font-bold text-slate-700">{{formatMoney this.estimated_cost}}</span>
                        {{/if}}

                        {{#if (eq this.status 'PENDING')}}
                          <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 font-bold text-[10px]">
                            Đang chờ trao
                          </span>
                        {{else if (eq this.status 'PROMISED')}}
                          <span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-bold text-[10px]">
                            Đã có người nhận
                          </span>
                        {{else if (eq this.status 'FULFILLED')}}
                          <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-[10px]">
                            Đã nhận quà
                          </span>
                        {{/if}}
                      </div>
                    </div>
                  {{/each}}
                </div>
              {{/if}}

              <!-- Form đăng ký điều ước mới -->
              <form action="/family/wishes/create" method="POST" class="p-4 rounded-xl bg-amber-50/40 border border-amber-200/80 space-y-3">
                <input type="hidden" name="child_id" value="{{this.id}}" />
                
                <div class="text-xs font-bold text-amber-900 flex items-center gap-1.5">
                  <span>🎁</span> Đăng Ký Thêm Điều Ước Mới Cho Bé:
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div class="sm:col-span-2">
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Món quà ước mơ của con *</label>
                    <input 
                      type="text" 
                      name="title" 
                      required 
                      placeholder="VD: Hộp màu vẽ sáp, Gấu bông thỏ trắng, Xe đồ chơi..."
                      class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500"
                    />
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Phân loại</label>
                    <select name="category" class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium">
                      <option value="TOY">🧸 Đồ chơi & Giải trí</option>
                      <option value="BOOK">📚 Sách truyện & Học tập</option>
                      <option value="CLOTHES">👕 Quần áo & Giày dép</option>
                      <option value="EXPERIENCE">🎡 Trải nghiệm & Ước mơ</option>
                      <option value="OTHER">🎁 Điều ước khác</option>
                    </select>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Chi phí ước tính (VNĐ)</label>
                    <input 
                      type="number" 
                      name="estimated_cost" 
                      placeholder="VD: 150000"
                      class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 font-mono focus:outline-none focus:ring-2 focus:ring-amber-500"
                    />
                  </div>
                  <div class="sm:col-span-2">
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Lời tâm sự / Mong muốn của bé</label>
                    <input 
                      type="text" 
                      name="description" 
                      placeholder="Con ước có hộp màu để vẽ tặng các bác sĩ..."
                      class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500"
                    />
                  </div>
                </div>

                <div class="flex justify-end pt-1">
                  <button 
                    type="submit" 
                    class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 rounded-xl shadow-sm transition-all hover:scale-[1.01]"
                  >
                    <span>Gửi Điều Ước Lên Cây 🌟</span>
                  </button>
                </div>
              </form>
            </div>

            <!-- ========================================== -->
            <!-- 🚨 RÚT HỒ SƠ KHẨN CẤP (ĐIỀU 33 LUẬT TRẺ EM 2016) -->
            <!-- ========================================== -->
            {{#if this.is_published}}
              <div class="p-5 rounded-2xl bg-rose-50/60 border-2 border-rose-200 space-y-3">
                <div class="flex items-center gap-2 text-rose-800 font-bold text-sm">
                  <span>🚨</span> Rút Hồ Sơ Khẩn Cấp (Emergency Unpublish - Quyền Được Quên)
                </div>

                <p class="text-xs text-rose-700 leading-relaxed">
                  Nếu gia đình không muốn tiếp tục hiển thị thông tin, hình ảnh hay hoàn cảnh của con trên cổng thông tin công cộng, bạn có thể thực hiện rút hồ sơ ngay lập tức. Hệ thống sẽ ẩn hồ sơ khỏi kết quả tìm kiếm và trang chủ ngay tức thì.
                </p>

                <form
                  action="/family/unpublish/{{this.id}}"
                  method="POST"
                  onsubmit="return confirm('XÁC NHẬN: Bạn có chắc chắn muốn rút và ẩn hồ sơ của bé {{this.full_name}} khỏi hệ thống công khai? Thao tác này sẽ có hiệu lực ngay lập tức.');"
                  class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2"
                >
                  <input
                    type="text"
                    name="reason"
                    placeholder="Lý do rút hồ sơ (Ví dụ: Con đã hoàn thành phác đồ điều trị, gia đình cần bảo mật riêng tư...)"
                    class="flex-1 px-3 py-2 text-xs bg-white border border-rose-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500"
                  />
                  
                  <button
                    type="submit"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-sm transition-all whitespace-nowrap"
                  >
                    <span>Ẩn hồ sơ ngay</span>
                  </button>
                </form>
              </div>
            {{else}}
              <div class="p-4 rounded-xl bg-slate-100 border border-slate-200 text-xs text-slate-600 flex items-center gap-2">
                <span>🔒</span>
                <span>Hồ sơ này đang ở trạng thái <strong>Ẩn bảo mật</strong>. Chỉ phụ huynh và ban quản trị hệ thống mới có thể xem được trong trang quản trị.</span>
              </div>
            {{/if}}

          </div>
        {{/each}}
      {{else}}
        <div class="text-center py-12 bg-white rounded-2xl border border-slate-200 p-8">
          <div class="h-12 w-12 mx-auto rounded-full bg-amber-100 flex items-center justify-center text-amber-700 text-xl mb-3">
            👶
          </div>
          <h3 class="text-sm font-bold text-slate-900">Chưa có hồ sơ bé nào liên kết với tài khoản này</h3>
          <p class="mt-1 text-xs text-slate-500 max-w-sm mx-auto">
            Hồ sơ gia đình được Điều phối viên hoặc Quản trị viên cấp sau khi đối soát hồ sơ bệnh án và giấy tờ pháp lý.
          </p>
        </div>
      {{/if}}
    </div>

  </div>
</div>

