<div id="media-upload-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
    <button
      type="button"
      onclick="closeMediaModal()"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 text-xl font-bold p-1"
    >
      ✕
    </button>

    <div class="mb-4">
      <span class="text-2xl">📸</span>
      <h3 class="text-lg font-extrabold text-slate-900 mt-1">Thêm Kỷ Niệm Cho Bé</h3>
      <p id="media-modal-subtitle" class="text-xs text-slate-500">
        Tải ảnh hoặc dán liên kết video YouTube kỷ niệm của bé.
      </p>
    </div>

    <form id="media-upload-form" action="/family/gallery/add" method="POST" class="space-y-4">
      <input type="hidden" id="modal_child_id" name="child_id" value="" />
      <input type="hidden" id="modal_base64" name="base64Data" value="" />

      <!-- Loại kỷ vật -->
      <div>
        <label class="block text-xs font-medium text-slate-700 mb-1">Loại kỷ vật *</label>
        <select 
          id="modal_media_type" 
          name="media_type" 
          onchange="handleMediaTypeChange()"
          class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-rose-500 font-medium"
        >
          <option value="IMAGE">🖼️ Hình ảnh kỷ niệm</option>
          <option value="DRAWING">🎨 Bức tranh vẽ của con</option>
          <option value="VIDEO">🎬 Video / Clip kỷ niệm (YouTube hoặc link MP4)</option>
        </select>
      </div>

      <!-- File upload cho IMAGE / DRAWING -->
      <div id="file-upload-section">
        <label class="block text-xs font-medium text-slate-700 mb-1">Chọn ảnh từ thiết bị</label>
        <input 
          type="file" 
          id="modal_file_input" 
          accept="image/*" 
          onchange="handleFileInputChange(event)"
          class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-rose-50 file:text-rose-700 hover:file:bg-rose-100 cursor-pointer"
        />
        <div id="image-preview-box" class="hidden mt-3 h-36 w-full rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
          <img id="image-preview" src="" alt="Xem trước ảnh" class="w-full h-full object-contain" />
        </div>
      </div>

      <!-- URL media input -->
      <div>
        <label id="url-input-label" class="block text-xs font-medium text-slate-700 mb-1">Hoặc nhập liên kết URL ảnh</label>
        <input
          type="text"
          id="modal_media_url"
          name="media_url"
          placeholder="https://... hoặc https://www.youtube.com/watch?v=..."
          class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500"
        />
        <span id="url-hint" class="text-[10px] text-slate-400 mt-1 block">Hỗ trợ đường dẫn ảnh trực tiếp hoặc ảnh tải từ máy.</span>
      </div>

      <!-- Caption -->
      <div>
        <label class="block text-xs font-medium text-slate-700 mb-1">Tiêu đề / Lời tựa kỷ niệm *</label>
        <input
          type="text"
          name="caption"
          required
          placeholder="VD: Nụ cười ngày sinh nhật tròn 5 tuổi của con, Bức tranh ngôi nhà hạnh phúc..."
          class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500"
        />
      </div>

      <div class="pt-2 flex items-center justify-end gap-2 border-t border-slate-100">
        <button
          type="button"
          onclick="closeMediaModal()"
          class="px-4 py-2 text-xs font-medium text-slate-600 hover:bg-slate-100 rounded-xl"
