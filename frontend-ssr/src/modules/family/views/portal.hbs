<div class="py-8 bg-slate-50 min-h-[calc(100vh-4rem)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header & Welcome Banner -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8 mb-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 mb-2">
            <span>👨‍👩‍👧</span> Cổng Hộ Gia Đình & Người Giám Hộ
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Quản Lý Hồ Sơ Chiến Binh Nhí
          </h1>
          <p class="mt-1 text-xs sm:text-sm text-slate-600">
            Xin chào phụ huynh <strong>{{user.full_name}}</strong> ({{user.email}}). Nơi gia đình cập nhật nhật ký cho con và kiểm soát quyền riêng tư.
          </p>
        </div>

        <a href="/warriors" class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
          <span>🌐</span> Xem trang công khai
        </a>
      </div>
    </div>

    <!-- Flash Notifications -->
    {{#if flashMessage}}
      <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold mb-6 flex items-start gap-2 shadow-sm">
        <span class="text-base">✓</span>
        <div>{{flashMessage}}</div>
      </div>
    {{/if}}

    {{#if errorMessage}}
      <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold mb-6 flex items-start gap-2 shadow-sm">
        <span class="text-base">✕</span>
        <div>{{errorMessage}}</div>
      </div>
    {{/if}}

    <!-- Legal Framework Banner -->
    <div class="p-4 rounded-xl bg-sky-50 border border-sky-200 text-sky-900 text-xs mb-8 flex items-start gap-3">
      <span class="text-lg">⚖️</span>
      <div class="leading-relaxed">
        <strong>Bảo đảm quyền riêng tư trẻ em theo Pháp luật Việt Nam:</strong> Căn cứ <em>Điều 33 Luật Trẻ em 2016</em> và <em>Nghị định 13/2023/NĐ-CP</em>, phụ huynh có toàn quyền sửa đổi thông tin và thực thi <strong>quyền rút hồ sơ khẩn cấp (Emergency Unpublish)</strong> bất kỳ thời điểm nào mà không cần chờ Admin xét duyệt.
      </div>
    </div>

    <!-- Children List Section -->
    <div class="space-y-8">
      <h2 class="text-lg font-bold text-slate-900 flex items-center gap-2">
        <span>🌟</span> Danh Sách Hồ Sơ Con Quản Lý ({{myChildren.length}})
      </h2>

      {{#if myChildren.length}}
        {{#each myChildren}}
          <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8 space-y-6">
            
            <!-- Child Status Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-slate-100">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="text-xl font-bold text-slate-900">{{this.full_name}}</h3>
                  {{#if this.nickname}}
                    <span class="text-sm font-semibold text-rose-600">({{this.nickname}})</span>
                  {{/if}}
                </div>
                
                <div class="flex flex-wrap items-center gap-2 text-xs">
                  <!-- Published Status -->
                  {{#if this.is_published}}
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-semibold bg-emerald-100 text-emerald-800">
                      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                      Đang hiển thị công khai
                    </span>
                  {{else}}
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-semibold bg-rose-100 text-rose-800">
                      <span class="h-1.5 w-1.5 rounded-full bg-rose-500"></span>
                      Đã ẩn an toàn (Quyền được quên)
                    </span>
                  {{/if}}

                  <!-- Medical Status -->
                  <span class="px-2.5 py-0.5 rounded-full font-medium bg-slate-100 text-slate-700">
                    Trạng thái: {{this.status}}
                  </span>

                  <!-- Candles -->
                  <span class="px-2.5 py-0.5 rounded-full font-medium bg-amber-50 text-amber-800 border border-amber-200">
                    🕯️ {{this.candle_count}} ngọn nến
                  </span>
                </div>
              </div>

              {{#if this.is_published}}
                <a
                  href="/warriors/{{this.slug}}"
                  target="_blank"
                  class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-xl transition-colors"
                >
                  Xem trang công khai ↗
                </a>
              {{/if}}
            </div>

            <!-- Update Story Form -->
            <div class="space-y-4">
              <h4 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                <span>✏️</span> Cập Nhật Nhật Ký & Ước Mơ Của Bé
              </h4>

              <form action="/family/update/{{this.id}}" method="POST" class="space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">Biệt danh ở nhà</label>
                    <input
                      type="text"
                      name="nickname"
                      value="{{this.nickname}}"
                      placeholder="Ví dụ: Bé Bơ, Heo Con..."
                      class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white"
                    />
                  </div>

                  <div>
                    <label class="block text-xs font-medium text-slate-700 mb-1">Tóm tắt ước mơ của bé</label>
                    <input
                      type="text"
                      name="dream_summary"
                      value="{{this.dream_summary}}"
                      placeholder="Ví dụ: Ước mơ trở thành họa sĩ vẽ tranh..."
                      class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-medium text-slate-700 mb-1">Nhật ký điều trị mới (Tin vui, tiến triển sức khỏe)</label>
                  <textarea
                    name="story_html"
                    rows="3"
                    placeholder="Viết cập nhật mới về quá trình điều trị của con..."
                    class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white"
                  ></textarea>
                </div>

                <div class="flex justify-end">
                  <button
                    type="submit"
                    class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-sm transition-all"
                  >
                    <span>Lưu cập nhật</span>
                  </button>
                </div>
              </form>
            </div>

            <!-- Cây Điều Ước Của Con -->
            <div class="pt-4 border-t border-slate-100 space-y-4">
              <div class="flex items-center justify-between">
                <h4 class="text-sm font-bold text-slate-900 flex items-center gap-2">
                  <span>🌟</span> Cây Điều Ước Của Con
                </h4>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800">
                  {{this.wishes.length}} điều ước
                </span>
              </div>

              <!-- Danh sách điều ước đã đăng ký -->
              {{#if this.wishes.length}}
                <div class="space-y-2">
                  {{#each this.wishes}}
                    <div class="p-3 rounded-xl border border-slate-200 bg-slate-50/70 flex items-center justify-between flex-wrap gap-2 text-xs">
                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                          <span class="font-bold text-slate-900">{{this.title}}</span>
                          <span class="text-[10px] font-semibold uppercase px-2 py-0.5 rounded bg-white text-slate-600 border border-slate-200">
                            {{this.category}}
                          </span>
                        </div>
                        {{#if this.description}}
                          <p class="text-[11px] text-slate-500 mt-0.5 italic">"{{this.description}}"</p>
                        {{/if}}
                        {{#if this.sponsor_name}}
                          <p class="text-[11px] text-blue-700 mt-0.5">
                            💌 Nhà hảo tâm nhận trao: <strong>{{this.sponsor_name}}</strong>
                          </p>
                        {{/if}}
                      </div>

                      <div class="flex items-center gap-3 shrink-0">
                        {{#if this.estimated_cost}}
                          <span class="font-mono font-bold text-slate-700">{{formatMoney this.estimated_cost}}</span>
                        {{/if}}

                        {{#if (eq this.status 'PENDING')}}
                          <span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 font-bold text-[10px]">
                            Đang chờ trao
                          </span>
                        {{else if (eq this.status 'PROMISED')}}
                          <span class="px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-bold text-[10px]">
                            Đã có người nhận
                          </span>
                        {{else if (eq this.status 'FULFILLED')}}
                          <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-bold text-[10px]">
                            Đã nhận quà
                          </span>
                        {{/if}}
                      </div>
                    </div>
                  {{/each}}
                </div>
              {{/if}}

              <!-- Form đăng ký điều ước mới -->
              <form action="/family/wishes/create" method="POST" class="p-4 rounded-xl bg-amber-50/40 border border-amber-200/80 space-y-3">
                <input type="hidden" name="child_id" value="{{this.id}}" />
                
                <div class="text-xs font-bold text-amber-900 flex items-center gap-1.5">
                  <span>🎁</span> Đăng Ký Thêm Điều Ước Mới Cho Bé:
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div class="sm:col-span-2">
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Món quà ước mơ của con *</label>
                    <input 
                      type="text" 
                      name="title" 
                      required 
                      placeholder="VD: Hộp màu vẽ sáp, Gấu bông thỏ trắng, Xe đồ chơi..."
                      class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500"
                    />
                  </div>
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Phân loại</label>
                    <select name="category" class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium">
                      <option value="TOY">🧸 Đồ chơi & Giải trí</option>
                      <option value="BOOK">📚 Sách truyện & Học tập</option>
                      <option value="CLOTHES">👕 Quần áo & Giày dép</option>
                      <option value="EXPERIENCE">🎡 Trải nghiệm & Ước mơ</option>
                      <option value="OTHER">🎁 Điều ước khác</option>
                    </select>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div>
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Chi phí ước tính (VNĐ)</label>
                    <input 
                      type="number" 
                      name="estimated_cost" 
                      placeholder="VD: 150000"
                      class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 font-mono focus:outline-none focus:ring-2 focus:ring-amber-500"
                    />
                  </div>
                  <div class="sm:col-span-2">
                    <label class="block text-[11px] font-semibold uppercase tracking-wider text-slate-600 mb-1">Lời tâm sự / Mong muốn của bé</label>
                    <input 
                      type="text" 
                      name="description" 
                      placeholder="Con ước có hộp màu để vẽ tặng các bác sĩ..."
                      class="w-full px-3 py-2 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500"
                    />
                  </div>
                </div>

                <div class="flex justify-end pt-1">
                  <button 
                    type="submit" 
                    class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-amber-600 hover:bg-amber-700 rounded-xl shadow-sm transition-all hover:scale-[1.01]"
                  >
                    <span>Gửi Điều Ước Lên Cây 🌟</span>
                  </button>
                </div>
              </form>
            </div>

            <!-- Emergency Unpublish Zone (Điều 33 Luật Trẻ em 2016) -->
            {{#if this.is_published}}
              <div class="p-5 rounded-2xl bg-rose-50/60 border-2 border-rose-200 space-y-3">
                <div class="flex items-center gap-2 text-rose-800 font-bold text-sm">
                  <span>🚨</span> Rút Hồ Sơ Khẩn Cấp (Emergency Unpublish - Quyền Được Quên)
                </div>

                <p class="text-xs text-rose-700 leading-relaxed">
                  Nếu gia đình không muốn tiếp tục hiển thị thông tin, hình ảnh hay hoàn cảnh của con trên cổng thông tin công cộng, bạn có thể thực hiện rút hồ sơ ngay lập tức. Hệ thống sẽ ẩn hồ sơ khỏi kết quả tìm kiếm và trang chủ ngay tức thì.
                </p>

                <form
                  action="/family/unpublish/{{this.id}}"
                  method="POST"
                  onsubmit="return confirm('XÁC NHẬN: Bạn có chắc chắn muốn rút và ẩn hồ sơ của bé {{this.full_name}} khỏi hệ thống công khai? Thao tác này sẽ có hiệu lực ngay lập tức.');"
                  class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-2"
                >
                  <input
                    type="text"
                    name="reason"
                    placeholder="Lý do rút hồ sơ (Ví dụ: Con đã hoàn thành phác đồ điều trị, gia đình cần bảo mật riêng tư...)"
                    class="flex-1 px-3 py-2 text-xs bg-white border border-rose-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500"
                  />
                  
                  <button
                    type="submit"
                    class="inline-flex items-center justify-center gap-2 px-5 py-2 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-sm transition-all whitespace-nowrap"
                  >
                    <span>Ẩn hồ sơ ngay</span>
                  </button>
                </form>
              </div>
            {{else}}
              <div class="p-4 rounded-xl bg-slate-100 border border-slate-200 text-xs text-slate-600 flex items-center gap-2">
                <span>🔒</span>
                <span>Hồ sơ này đang ở trạng thái <strong>Ẩn bảo mật</strong>. Chỉ phụ huynh và ban quản trị hệ thống mới có thể xem được trong trang quản trị.</span>
              </div>
            {{/if}}

          </div>
        {{/each}}
      {{else}}
        <div class="text-center py-12 bg-white rounded-2xl border border-slate-200 p-8">
          <div class="h-12 w-12 mx-auto rounded-full bg-amber-100 flex items-center justify-center text-amber-700 text-xl mb-3">
            👶
          </div>
          <h3 class="text-sm font-bold text-slate-900">Chưa có hồ sơ bé nào liên kết với tài khoản này</h3>
          <p class="mt-1 text-xs text-slate-500 max-w-sm mx-auto">
            Hồ sơ gia đình được Điều phối viên hoặc Quản trị viên cấp sau khi đối soát hồ sơ bệnh án và giấy tờ pháp lý.
          </p>
        </div>
      {{/if}}
    </div>

  </div>
</div>
