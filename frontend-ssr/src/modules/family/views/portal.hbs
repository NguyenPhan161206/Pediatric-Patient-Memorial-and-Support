          Lưu Vào Kho Kỷ Niệm
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ======================================================== -->
<!-- CLIENT-SIDE SCRIPTS: LIVE PREVIEW & HTML5 AUDIO RECORDER -->
<!-- ======================================================== -->
<script>
  // Live Preview Cài đặt danh xưng
  function updateFamilyLivePreview() {
    const gender = document.getElementById('f_gender')?.value || 'UNSPECIFIED';
    const titlePrefix = document.getElementById('f_title_prefix')?.value?.trim() || '';
    const familyRelation = document.getElementById('f_family_relation')?.value?.trim() || '';
    const lastName = document.getElementById('f_last_name')?.value?.trim() || '';
    const middleName = document.getElementById('f_middle_name')?.value?.trim() || '';
    const firstName = document.getElementById('f_first_name')?.value?.trim() || '';
    const displayMode = document.getElementById('f_display_mode')?.value || 'FULL_NAME';

    let coreName = [lastName, middleName, firstName].filter(Boolean).join(' ');
    if (displayMode === 'FIRST_ONLY' && firstName) coreName = firstName;
    else if (displayMode === 'LAST_FIRST' && (lastName || firstName)) coreName = [lastName, firstName].filter(Boolean).join(' ');
    else if (displayMode === 'INITIALS') {
      const parts = [lastName, middleName, firstName].filter(Boolean);
      coreName = parts.map(p => p[0].toUpperCase() + '.').join(' ');
    } else if (displayMode === 'ANONYMOUS') {
      coreName = familyRelation || 'Phụ huynh bé';
    }

    // Salutations
    let salutationVi = '';
    let salutationEn = '';
    if (gender === 'MALE') {
      salutationVi = 'Ông';
      salutationEn = 'Mr.';
    } else if (gender === 'FEMALE') {
      salutationVi = 'Bà';
      salutationEn = 'Mrs.';
    } else if (gender === 'OTHER') {
      salutationEn = 'Mx.';
    }

    const viParts = [salutationVi, titlePrefix, coreName].filter(Boolean).join(' ');
    const enParts = [salutationEn, titlePrefix, coreName].filter(Boolean).join(' ');

    const previewViEl = document.getElementById('family_preview_vi');
    const previewEnEl = document.getElementById('family_preview_en');
    if (previewViEl) previewViEl.textContent = viParts || 'Chưa nhập tên';
    if (previewEnEl) previewEnEl.textContent = enParts || 'Chưa nhập tên';
  }

  ['f_gender', 'f_title_prefix', 'f_family_relation', 'f_last_name', 'f_middle_name', 'f_first_name', 'f_display_mode'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', updateFamilyLivePreview);
    document.getElementById(id)?.addEventListener('change', updateFamilyLivePreview);
  });

  // Modal Thêm Ảnh/Video
  function openMediaModal(childId, childName) {
    document.getElementById('modal_child_id').value = childId;
    document.getElementById('media-modal-subtitle').textContent = `Tải kỷ niệm cho bé ${childName}`;
    document.getElementById('media-upload-modal').classList.remove('hidden');
  }

  function closeMediaModal() {
    document.getElementById('media-upload-modal').classList.add('hidden');
    document.getElementById('media-upload-form').reset();
    document.getElementById('image-preview-box').classList.add('hidden');
    document.getElementById('modal_base64').value = '';
  }

  function handleMediaTypeChange() {
    const type = document.getElementById('modal_media_type').value;
    const fileSec = document.getElementById('file-upload-section');
    const urlLabel = document.getElementById('url-input-label');
    const urlHint = document.getElementById('url-hint');

    if (type === 'VIDEO') {
      fileSec.classList.add('hidden');
      urlLabel.textContent = 'Đường dẫn video YouTube hoặc link MP4 *';
      urlHint.textContent = 'Dán liên kết YouTube (VD: https://www.youtube.com/watch?v=... hoặc https://youtu.be/...) để hệ thống tự động nhúng video player.';
      document.getElementById('modal_media_url').setAttribute('required', 'required');
    } else {
      fileSec.classList.remove('hidden');
      urlLabel.textContent = 'Hoặc nhập liên kết URL ảnh';
      urlHint.textContent = 'Hỗ trợ định dạng PNG, JPG, WEBP trực tiếp hoặc ảnh tải từ máy tính/điện thoại.';
      document.getElementById('modal_media_url').removeAttribute('required');
    }
  }

  function handleFileInputChange(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function(evt) {
      const base64 = evt.target.result;
      document.getElementById('modal_base64').value = base64;
      document.getElementById('image-preview').src = base64;
      document.getElementById('image-preview-box').classList.remove('hidden');
    };
    reader.readAsDataURL(file);
  }

  // HTML5 Web Audio Voice Recorder
  const activeRecorders = {};

  async function toggleRecording(childId) {
    const btn = document.getElementById(`rec_btn_${childId}`);
    const label = document.getElementById(`rec_label_${childId}`);
    const timer = document.getElementById(`rec_timer_${childId}`);
    const wave = document.getElementById(`rec_wave_${childId}`);
    const status = document.getElementById(`rec_status_${childId}`);

    if (activeRecorders[childId] && activeRecorders[childId].state === 'recording') {
      // Dừng thu âm
      activeRecorders[childId].mediaRecorder.stop();
      return;
    }

    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const mediaRecorder = new MediaRecorder(stream);
      const audioChunks = [];
      let seconds = 0;

      mediaRecorder.ondataavailable = e => {
        if (e.data.size > 0) audioChunks.push(e.data);
      };

      mediaRecorder.onstart = () => {
        btn.classList.remove('bg-rose-600', 'hover:bg-rose-700');
        btn.classList.add('bg-slate-900', 'hover:bg-slate-800');
        label.textContent = 'Dừng thu âm ⏹️';
        timer.classList.remove('hidden');
        wave.classList.remove('hidden');
        wave.classList.add('flex');
        status.textContent = 'Đang thu âm... Hãy nói hoặc hát ru bé một cách tự nhiên nhất.';

        const interval = setInterval(() => {
          seconds++;
          const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
          const secs = String(seconds % 60).padStart(2, '0');
          timer.textContent = `${mins}:${secs}`;
        }, 1000);

        activeRecorders[childId].timerInterval = interval;
      };

      mediaRecorder.onstop = () => {
        clearInterval(activeRecorders[childId].timerInterval);
        stream.getTracks().forEach(track => track.stop());

        const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
        const audioUrl = URL.createObjectURL(audioBlob);

        const audioElement = document.getElementById(`rec_audio_${childId}`);
        audioElement.src = audioUrl;

        // Chuyển blob sang base64 data URL
        const reader = new FileReader();
        reader.onloadend = () => {
          document.getElementById(`rec_base64_${childId}`).value = reader.result;
          document.getElementById(`rec_duration_${childId}`).value = seconds;
        };
        reader.readAsDataURL(audioBlob);

        // Hiển thị preview box
        document.getElementById(`rec_preview_box_${childId}`).classList.remove('hidden');

        btn.classList.remove('bg-slate-900', 'hover:bg-slate-800');
        btn.classList.add('bg-rose-600', 'hover:bg-rose-700');
        label.textContent = 'Thu âm lại 🎙️';
        wave.classList.add('hidden');
        wave.classList.remove('flex');
        status.textContent = 'Đã thu âm xong! Hãy nghe lại bản thu trước khi gửi lưu.';
        activeRecorders[childId].state = 'idle';
      };

      mediaRecorder.start();
      activeRecorders[childId] = {
        state: 'recording',
        mediaRecorder
      };
    } catch (err) {
      console.error('Lỗi truy cập micro:', err);
      alert('Không thể truy cập Microphone trên thiết bị của bạn. Vui lòng cấp quyền micro cho trình duyệt.');
    }
  }

  function resetRecorder(childId) {
    document.getElementById(`rec_preview_box_${childId}`).classList.add('hidden');
    document.getElementById(`rec_base64_${childId}`).value = '';
    document.getElementById(`rec_duration_${childId}`).value = 0;
    document.getElementById(`rec_timer_${childId}`).textContent = '00:00';
    document.getElementById(`rec_label_${childId}`).textContent = 'Bắt đầu thu âm';
    document.getElementById(`rec_status_${childId}`).textContent = 'Nhấn nút để bắt đầu thu âm lại.';
  }
</script>
