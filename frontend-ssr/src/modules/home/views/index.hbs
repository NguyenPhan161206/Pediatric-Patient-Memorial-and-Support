<div class="space-y-16 pb-16">

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden bg-white border-b border-slate-200 py-16 sm:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      
      <!-- Pill Badge (shadcn/ui style) -->
      <div class="inline-flex items-center gap-2 rounded-full border border-rose-200 bg-rose-50/70 px-3 py-1 text-xs font-medium text-rose-700 mb-6 shadow-sm">
        <span class="flex h-2 w-2 rounded-full bg-rose-500 animate-pulse"></span>
        Cổng Ký Ức, Tri Ân & Vinh Danh Các Chiến Binh Nhí
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 max-w-4xl mx-auto leading-tight">
        Mỗi Nụ Cười Là Một <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-500 to-amber-500">Phép Màu</span>,<br class="hidden sm:inline"> 
        Mỗi Bước Đi Là Một <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Kỳ Tích</span>
      </h1>

      <p class="mt-6 text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed">
        Không gian số hóa trang trọng lưu giữ câu chuyện nghị lực, tranh vẽ và ước mơ của các bệnh nhi hiểm nghèo. 
        Hãy cùng thắp lên ngọn nến hy vọng và trao gửi yêu thương trực tiếp đến các bé.
      </p>

      <!-- Action Buttons -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/warriors" class="inline-flex items-center justify-center text-sm font-semibold bg-rose-600 text-white hover:bg-rose-700 h-11 px-6 rounded-lg shadow-sm shadow-rose-200 transition-all hover:scale-[1.02]">
          Tìm hiểu các chiến binh nhí
          <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
        <a href="#system-health" class="inline-flex items-center justify-center text-sm font-medium border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 h-11 px-6 rounded-lg transition-colors">
          Kiểm tra kết nối hệ thống 3 tầng
        </a>
      </div>
    </div>
  </section>


  <!-- SECTION: KIỂM TRA TRẠNG THÁI HỆ THỐNG 3 TẦNG (LIVE HEALTH STATUS) -->
  <section id="system-health" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 mb-6 border-b border-slate-100 gap-4">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-lg font-bold text-slate-900 tracking-tight">Trạng Thái Hệ Thống 3-Tier (Decoupled Architecture)</h2>
            <span class="inline-flex items-center rounded-md bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700 ring-1 ring-inset ring-emerald-600/20">Thời gian thực</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Đo kiểm tự động kết nối thông suốt giữa Frontend SSR, Backend API và PostgreSQL Database.</p>
        </div>
        <div class="text-xs text-slate-400 font-mono">
          Thời gian: {{health.timestamp}}
        </div>
      </div>

      <!-- 3 Tier Cards (shadcn/ui Card Component) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- TẦNG 1: FRONTEND SSR -->
        <div class="rounded-lg border border-slate-200 bg-slate-50/50 p-5 transition-all hover:border-slate-300">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Tầng 1: Web SSR</span>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span> Online
            </span>
          </div>
          <h3 class="text-base font-bold text-slate-900">Frontend Web Server</h3>
          <p class="text-xs text-slate-500 mt-1">Node.js / ExpressJS + Handlebars SSR</p>
          <div class="mt-4 pt-3 border-t border-slate-200/60 flex justify-between text-xs text-slate-600">
            <span>Cổng dịch vụ:</span>
            <span class="font-mono font-medium text-slate-900">3000 (HTTP)</span>
          </div>
        </div>

        <!-- TẦNG 2: BACKEND API -->
        <div class="rounded-lg border border-slate-200 bg-slate-50/50 p-5 transition-all hover:border-slate-300">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Tầng 2: REST API</span>
            {{#if (eq health.status "UP")}}
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span> Khỏe mạnh (UP)
              </span>
            {{else}}
              <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-600"></span> Chờ phản hồi
              </span>
            {{/if}}
          </div>
          <h3 class="text-base font-bold text-slate-900">Backend Core Service</h3>
          <p class="text-xs text-slate-500 mt-1">ExpressJS + Knex.js Query Builder</p>
          <div class="mt-4 pt-3 border-t border-slate-200/60 flex justify-between text-xs text-slate-600">
            <span>Cổng nội bộ:</span>
            <span class="font-mono font-medium text-slate-900">5000 (JSON API)</span>
          </div>
        </div>

        <!-- TẦNG 3: DATABASE POSTGRESQL -->
        <div class="rounded-lg border border-slate-200 bg-slate-50/50 p-5 transition-all hover:border-slate-300">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-500">Tầng 3: Database</span>
            {{#if (eq health.database "CONNECTED")}}
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-600"></span> Đã kết nối
              </span>
            {{else}}
              <span class="inline-flex items-center gap-1 rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-semibold text-rose-800">
                <span class="h-1.5 w-1.5 rounded-full bg-rose-600"></span> Mất kết nối
              </span>
            {{/if}}
          </div>
          <h3 class="text-base font-bold text-slate-900">PostgreSQL 16 Engine</h3>
          <p class="text-xs text-slate-500 mt-1">Quan hệ chuẩn 3NF & FTS tsvector</p>
          <div class="mt-4 pt-3 border-t border-slate-200/60 flex justify-between text-xs text-slate-600">
            <span>Quản trị GUI:</span>
            <a href="http://localhost:5050" target="_blank" class="font-mono font-medium text-indigo-600 hover:underline">pgAdmin :5050 ↗</a>
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- SECTION: CARD HỒ SƠ MẪU (PHONG CÁCH SHADCN/UI) -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Những Ngọn Nến Hy Vọng</h2>
        <p class="text-sm text-slate-500 mt-1">Lưu giữ hành trình chiến binh của các bé.</p>
      </div>
      <a href="/warriors" class="text-sm font-semibold text-rose-600 hover:text-rose-700 flex items-center gap-1">
        Xem tất cả các bé <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      
      <!-- Card 1 -->
      <div class="group rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition-all">
        <div class="aspect-[16/10] bg-slate-100 relative overflow-hidden flex items-center justify-center">
          <img src="https://images.unsplash.com/photo-1544717305-2782549b5136?w=600&auto=format&fit=crop&q=80" alt="Bé Minh An" class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-300">
          <span class="absolute top-3 left-3 inline-flex items-center rounded-md bg-rose-50 px-2.5 py-1 text-xs font-semibold text-rose-700 ring-1 ring-inset ring-rose-600/20 backdrop-blur-md">
            Chiến binh kiên cường
          </span>
          <span class="absolute top-3 right-3 inline-flex items-center gap-1 rounded-md bg-black/60 px-2.5 py-1 text-xs font-medium text-white backdrop-blur-md">
            🕯️ 142 ngọn nến
          </span>
        </div>
        <div class="p-5">
          <div class="text-xs text-slate-500 mb-1">Hà Nội • 6 tuổi</div>
          <h3 class="text-lg font-bold text-slate-900 group-hover:text-rose-600 transition-colors">Bé Minh An (Bé Bo)</h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 line-clamp-2">
            "Con ước mơ sau này khỏi bệnh sẽ làm chú cảnh sát giao thông để giúp đỡ các em nhỏ qua đường..."
          </p>
          <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-medium text-slate-500">Ung thư máu (ALL)</span>
            <a href="/warriors/minh-an" class="inline-flex items-center text-xs font-semibold text-slate-900 hover:text-rose-600">
              Đọc câu chuyện &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="group rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition-all">
        <div class="aspect-[16/10] bg-slate-100 relative overflow-hidden flex items-center justify-center">
          <img src="https://images.unsplash.com/photo-1485546246426-74dc88dec4d9?w=600&auto=format&fit=crop&q=80" alt="Bé Mai Chi" class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-300">
          <span class="absolute top-3 left-3 inline-flex items-center rounded-md bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-700 ring-1 ring-inset ring-amber-600/20 backdrop-blur-md">
            Cần bảo trợ khẩn cấp
          </span>
          <span class="absolute top-3 right-3 inline-flex items-center gap-1 rounded-md bg-black/60 px-2.5 py-1 text-xs font-medium text-white backdrop-blur-md">
            🕯️ 320 ngọn nến
          </span>
        </div>
        <div class="p-5">
          <div class="text-xs text-slate-500 mb-1">Nghệ An • 4 tuổi</div>
          <h3 class="text-lg font-bold text-slate-900 group-hover:text-rose-600 transition-colors">Bé Mai Chi (Bông)</h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 line-clamp-2">
            "Bông thích vẽ tranh hoa hướng dương và những chú bướm xinh xắn trong phòng cách ly viện nhi..."
          </p>
          <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-medium text-emerald-600 flex items-center gap-1">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              VietQR Đã Thẩm Định
            </span>
            <a href="/warriors/mai-chi" class="inline-flex items-center text-xs font-semibold text-slate-900 hover:text-rose-600">
              Đọc câu chuyện &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="group rounded-xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-md transition-all">
        <div class="aspect-[16/10] bg-slate-100 relative overflow-hidden flex items-center justify-center">
          <img src="https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?w=600&auto=format&fit=crop&q=80" alt="Bé Tuấn Kiệt" class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-300">
          <span class="absolute top-3 left-3 inline-flex items-center rounded-md bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 ring-1 ring-inset ring-blue-600/20 backdrop-blur-md">
            Chiến thắng bệnh tật
          </span>
          <span class="absolute top-3 right-3 inline-flex items-center gap-1 rounded-md bg-black/60 px-2.5 py-1 text-xs font-medium text-white backdrop-blur-md">
            🕯️ 580 ngọn nến
          </span>
        </div>
        <div class="p-5">
          <div class="text-xs text-slate-500 mb-1">Đà Nẵng • 8 tuổi</div>
          <h3 class="text-lg font-bold text-slate-900 group-hover:text-rose-600 transition-colors">Bé Tuấn Kiệt</h3>
          <p class="text-xs sm:text-sm text-slate-600 mt-2 line-clamp-2">
            Sau 3 năm chiến đấu bền bỉ cùng bố mẹ, con đã chính thức được bác sĩ cho xuất viện và trở lại trường học.
          </p>
          <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-xs font-medium text-slate-500">U nguyên bào thận</span>
            <a href="/warriors/tuan-kiet" class="inline-flex items-center text-xs font-semibold text-slate-900 hover:text-rose-600">
              Đọc câu chuyện &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

</div>
