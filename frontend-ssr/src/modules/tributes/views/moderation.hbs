<div class="py-8 bg-slate-50 min-h-[calc(100vh-4rem)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header Section -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8 mb-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800 mb-2">
            <span>🛡️</span> Kiểm Duyệt Tiền Kiểm (Pre-Moderation)
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Kiểm Duyệt Lời Chúc & Tri Ân
          </h1>
          <p class="mt-1 text-xs sm:text-sm text-slate-600">
            Bảo vệ không gian tinh thần lành mạnh, văn minh và ấm áp cho các chiến binh nhí và gia đình.
          </p>
        </div>

        <div class="text-xs text-slate-500 bg-slate-50 border border-slate-200 px-3.5 py-2 rounded-xl">
          Đang chờ duyệt: <strong class="text-indigo-600 text-sm">{{pendingTributes.length}}</strong>
        </div>
      </div>
    </div>

    <!-- Flash Notifications -->
    {{#if flashMessage}}
      <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold mb-6 flex items-start gap-2 shadow-sm">
        <span class="text-base">✓</span>
        <div>{{flashMessage}}</div>
      </div>
    {{/if}}

    {{#if errorMessage}}
      <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold mb-6 flex items-start gap-2 shadow-sm">
        <span class="text-base">✕</span>
        <div>{{errorMessage}}</div>
      </div>
    {{/if}}

    <!-- Legal Framework Banner -->
    <div class="p-4 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-950 text-xs mb-8 flex items-start gap-3">
      <span class="text-lg">📜</span>
      <div class="leading-relaxed">
        <strong>Quy định kiểm duyệt nội dung theo Nghị định 147/2024/NĐ-CP & Luật Trẻ em 2016:</strong>
        Mọi lời nhắn, bình luận gửi tới trẻ em phải được kiểm duyệt chặt chẽ để loại bỏ bạo lực mạng, ngôn từ tiêu cực, thông tin sai sự thật hoặc quảng cáo không phép trước khi hiển thị công khai.
      </div>
    </div>

    <!-- Pending Tributes List -->
    {{#if pendingTributes.length}}
      <div class="space-y-4 mb-10">
        {{#each pendingTributes}}
          <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 hover:border-slate-300 transition-all">
            <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
              
              <!-- Content details -->
              <div class="flex-1 space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs font-bold text-slate-900 bg-slate-100 px-2.5 py-1 rounded-md">
                    Gửi tới bé: <a href="/warriors/{{this.child_slug}}" target="_blank" class="text-rose-600 hover:underline font-bold">{{this.child_name}}</a>
                  </span>
                  <span class="text-xs text-slate-400">•</span>
                  <span class="text-xs text-slate-500">Thời gian: {{formatDate this.created_at}}</span>
                </div>

                <div class="text-xs text-slate-600">
                  Người gửi: <strong class="text-slate-800">{{this.sender_name}}</strong>
                  {{#if this.sender_email}}
                    <span class="text-slate-400 font-mono">({{this.sender_email}})</span>
                  {{/if}}
                </div>

                <!-- Message Body -->
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-800 leading-relaxed italic">
                  "{{this.content}}"
                </div>

                <!-- Voice Note Audio Auditing -->
                {{#if this.audio_url}}
                  <div class="p-3 rounded-xl bg-indigo-50/70 border border-indigo-200/80 space-y-1.5">
                    <div class="flex items-center justify-between text-[11px] font-bold text-indigo-900">
                      <span class="flex items-center gap-1.5">
                        <span>🎙️</span> Thẩm định tin nhắn thoại / Lời ru {{#if this.duration_seconds}}({{this.duration_seconds}}s){{/if}}
                      </span>
                      <span class="text-[10px] text-indigo-700 bg-white px-2 py-0.5 rounded border border-indigo-200 font-mono">Bản ghi âm tiền kiểm</span>
                    </div>
                    <audio controls class="w-full h-8" src="{{this.audio_url}}"></audio>
                  </div>
                {{/if}}
              </div>

              <!-- Action Buttons -->
              <div class="flex md:flex-col items-center gap-2 shrink-0">
                <!-- Approve Button -->
                <form action="/tributes/moderation/{{this.id}}/approve" method="POST" class="w-full">
                  <button
                    type="submit"
                    class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm transition-all"
                  >
                    <span>✓</span>
                    <span>Phê duyệt</span>
                  </button>
                </form>

                <!-- Reject Button -->
                <form
                  action="/tributes/moderation/{{this.id}}/reject"
                  method="POST"
                  onsubmit="return confirm('Bạn có chắc chắn muốn từ chối lời chúc này?');"
                  class="w-full"
                >
                  <button
                    type="submit"
                    class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 text-xs font-semibold text-rose-600 hover:text-white bg-rose-50 hover:bg-rose-600 rounded-xl transition-all"
                  >
                    <span>✕</span>
                    <span>Từ chối</span>
                  </button>
                </form>
              </div>

            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <!-- Empty State -->
      <div class="text-center py-16 bg-white rounded-2xl border border-slate-200 p-8">
        <div class="h-16 w-16 mx-auto rounded-full bg-emerald-50 flex items-center justify-center text-emerald-600 text-2xl mb-4">
          ✨
        </div>
        <h3 class="text-base font-bold text-slate-900">Không có lời chúc nào đang chờ duyệt</h3>
        <p class="mt-1 text-xs text-slate-500 max-w-sm mx-auto">
          Tất cả lời chúc gửi đến các chiến binh nhí đều đã được xử lý xong. Cảm ơn sự tận tâm của bạn!
        </p>
        <div class="mt-5">
          <a href="/warriors" class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
            Xem danh sách chiến binh
          </a>
        </div>
      </div>
    {{/if}}

  </div>
</div>
