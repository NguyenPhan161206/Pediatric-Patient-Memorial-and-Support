<!-- MODAL 4: XEM ẢNH QR PHÓNG TO -->
<div id="qrPreviewModal" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-sm hidden items-center justify-center p-4" onclick="closeQRPreview()">
  <div class="bg-white rounded-3xl border border-slate-200 p-6 max-w-sm w-full text-center space-y-3" onclick="event.stopPropagation()">
    <div class="flex items-center justify-between">
      <h4 class="text-xs font-bold text-slate-800" id="qrPreviewTitle">Ảnh Mã QR Của Gia Đình</h4>
      <button type="button" onclick="closeQRPreview()" class="text-slate-400 hover:text-slate-700 font-bold text-sm">✕</button>
    </div>
    <div class="p-3 bg-slate-50 rounded-2xl flex items-center justify-center">
      <img id="qrPreviewImg" src="" alt="Mã QR" class="max-h-80 w-auto rounded-xl object-contain shadow-sm" />
    </div>
    <p class="text-[11px] text-slate-400">Kiểm tra thông tin tài khoản thụ hưởng trước khi bấm phê duyệt</p>
  </div>
</div>

<script>
  function openCreateWarriorModal() {
    const modal = document.getElementById('createWarriorModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeCreateWarriorModal() {
    const modal = document.getElementById('createWarriorModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function openFamilyProvisionModal(childId, childName) {
    document.getElementById('provisionChildId').value = childId;
    document.getElementById('provisionChildName').textContent = childName;
    const modal = document.getElementById('provisionFamilyModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeFamilyProvisionModal() {
    const modal = document.getElementById('provisionFamilyModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function openRejectModal(childId, childName) {
    document.getElementById('rejectChildName').textContent = childName;
    document.getElementById('rejectQRForm').action = '/organizations/portal/warriors/' + childId + '/verify-family-bank';
    const modal = document.getElementById('rejectQRModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeRejectModal() {
    const modal = document.getElementById('rejectQRModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  function previewQRImage(src, name) {
    document.getElementById('qrPreviewImg').src = src;
    document.getElementById('qrPreviewTitle').textContent = 'Ảnh Mã QR - Bé ' + name;
    const modal = document.getElementById('qrPreviewModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeQRPreview() {
    const modal = document.getElementById('qrPreviewModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
</script>

