<div class="py-8 bg-slate-50 min-h-[calc(100vh-4rem)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header Section -->
    <div class="mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-rose-100 text-rose-800 mb-3">
        <span>🌟</span> Cổng Lưu Trữ & Tri Ân
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Danh Sách Các Chiến Binh Nhí
      </h1>
      <p class="mt-2 text-slate-600 text-base max-w-2xl">
        Nơi tôn vinh nghị lực kiên cường, lưu giữ ký ức tươi đẹp và trao gửi hy vọng đến những thiên thần nhỏ trên hành trình vượt qua bệnh tật hiểm nghèo.
      </p>
    </div>

    <!-- Search & Filter Bar (FTS + Metadata Filters) -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm mb-8">
      <form action="/warriors" method="GET" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          
          <!-- Full Text Search Input -->
          <div class="lg:col-span-2">
            <label for="q" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Tìm kiếm toàn văn (Tên, ước mơ, quê quán)
            </label>
            <div class="relative">
              <input
                type="text"
                id="q"
                name="q"
                value="{{query.q}}"
                placeholder="Ví dụ: Bơ, cảnh sát, Hà Nội, bạch cầu..."
                class="w-full pl-10 pr-4 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white transition-all"
              />
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
            </div>
          </div>

          <!-- Category Filter -->
          <div>
            <label for="category" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Nhóm bệnh lý
            </label>
            <select
              id="category"
              name="category"
              class="w-full px-3 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white transition-all"
            >
              <option value="">-- Tất cả nhóm bệnh --</option>
              {{#each categories}}
                <option value="{{this.id}}" {{#if (eq ../query.category (lookup this 'id'))}}selected{{/if}}>
                  {{this.name}}
                </option>
              {{/each}}
            </select>
          </div>

          <!-- Status Filter -->
          <div>
            <label for="status" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
              Trạng thái điều trị
            </label>
            <select
              id="status"
              name="status"
              class="w-full px-3 py-2.5 text-sm bg-slate-50 border border-slate-300 rounded-xl text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:bg-white transition-all"
            >
              <option value="">-- Tất cả trạng thái --</option>
              <option value="FIGHTER" {{#if (eq query.status "FIGHTER")}}selected{{/if}}>Đang chiến đấu (FIGHTER)</option>
              <option value="URGENT" {{#if (eq query.status "URGENT")}}selected{{/if}}>Khẩn cấp (URGENT)</option>
              <option value="RECOVERED" {{#if (eq query.status "RECOVERED")}}selected{{/if}}>Đã hồi phục (RECOVERED)</option>
              <option value="ANGEL" {{#if (eq query.status "ANGEL")}}selected{{/if}}>Thiên thần (ANGEL)</option>
            </select>
          </div>
        </div>

        <div class="flex items-center justify-between pt-2 border-t border-slate-100">
          <div class="text-xs text-slate-500">
            Tìm thấy <strong class="text-slate-900">{{pagination.total}}</strong> chiến binh nhí phù hợp
          </div>
          <div class="flex items-center gap-2">
            <a href="/warriors" class="px-4 py-2 text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-colors">
              Xóa lọc
            </a>
            <button
              type="submit"
              class="inline-flex items-center gap-2 px-5 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow-sm transition-all"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
              </svg>
              Lọc kết quả
            </button>
          </div>
        </div>
      </form>
    </div>

    <!-- Warriors Card Grid -->
    {{#if warriors.length}}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        {{#each warriors}}
          <div class="group flex flex-col bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md hover:border-slate-300 transition-all overflow-hidden">
            
            <!-- Card Image & Badges -->
            <div class="relative h-56 bg-slate-100 overflow-hidden">
              <img
                src="{{this.avatar_url}}"
                alt="{{this.full_name}}"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                onerror="this.src='https://images.unsplash.com/photo-1544717305-2782549b5136?w=600&auto=format&fit=crop&q=80'"
              />
              
              <!-- Status Badge -->
              <div class="absolute top-3 left-3">
                {{#if (eq this.status "URGENT")}}
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-rose-600 text-white shadow-sm shadow-rose-500/30">
                    <span class="h-2 w-2 rounded-full bg-white animate-ping"></span>
                    Khẩn cấp
                  </span>
                {{else if (eq this.status "FIGHTER")}}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-sky-100 text-sky-800 border border-sky-200">
                    Đang chiến đấu
                  </span>
                {{else if (eq this.status "RECOVERED")}}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
                    Hồi phục kỳ diệu
                  </span>
                {{else if (eq this.status "ANGEL")}}
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-800 border border-purple-200">
                    Thiên thần nhỏ
                  </span>
                {{/if}}
              </div>

              <!-- Candles Counter Badge -->
              <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-2.5 py-1 rounded-full text-xs font-bold text-amber-700 shadow-sm border border-amber-200/50 flex items-center gap-1">
                <span>🕯️</span>
                <span>{{this.candle_count}}</span>
              </div>
            </div>

            <!-- Card Content Body -->
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <!-- Category & Hometown -->
                <div class="flex items-center justify-between text-xs text-slate-500 mb-2">
                  <span class="font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded-md">
                    {{this.category_name}}
                  </span>
                  <span>📍 {{this.hometown}}</span>
                </div>

                <!-- Name & Nickname -->
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-rose-600 transition-colors">
                  {{this.full_name}}
                  {{#if this.nickname}}
                    <span class="text-sm font-normal text-slate-500">({{this.nickname}})</span>
                  {{/if}}
                </h3>

                <!-- Dream Excerpt -->
                <p class="mt-2 text-xs text-slate-600 line-clamp-2 leading-relaxed">
                  "{{this.dream_summary}}"
                </p>
              </div>

              <!-- Card Footer Action -->
              <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                <div class="text-[11px] text-emerald-700 font-medium flex items-center gap-1">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                  VietQR Chính Chủ
                </div>

                <a
                  href="/warriors/{{this.slug}}"
                  class="inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-rose-600 hover:text-white bg-rose-50 hover:bg-rose-600 rounded-lg transition-all"
                >
                  Xem hồ sơ
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>

          </div>
        {{/each}}
      </div>

      <!-- Pagination -->
      {{#if (gt pagination.totalPages 1)}}
        <div class="flex items-center justify-center gap-2 pt-4 border-t border-slate-200">
          {{#each pageNumbers}}
            <a
              href="/warriors?page={{this.number}}{{#if ../query.q}}&q={{../query.q}}{{/if}}{{#if ../query.category}}&category={{../query.category}}{{/if}}{{#if ../query.status}}&status={{../query.status}}{{/if}}"
              class="h-9 w-9 rounded-lg flex items-center justify-center text-xs font-semibold transition-all
              {{#if this.isCurrent}}
                bg-slate-900 text-white shadow-sm
              {{else}}
                bg-white border border-slate-200 text-slate-700 hover:bg-slate-100
              {{/if}}"
            >
              {{this.number}}
            </a>
          {{/each}}
        </div>
      {{/if}}

    {{else}}
      <!-- Empty State -->
      <div class="text-center py-16 bg-white rounded-2xl border border-slate-200 p-8">
        <div class="h-16 w-16 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400 text-2xl mb-4">
          🔍
        </div>
        <h3 class="text-base font-bold text-slate-900">Không tìm thấy chiến binh nhí nào</h3>
        <p class="mt-1 text-sm text-slate-500 max-w-sm mx-auto">
          Không có kết quả nào phù hợp với từ khóa hoặc bộ lọc bạn đã chọn. Hãy thử tìm từ khóa khác nhé.
        </p>
        <div class="mt-5">
          <a href="/warriors" class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors">
            Xóa bộ lọc & Hiển thị tất cả
          </a>
        </div>
      </div>
    {{/if}}

  </div>
</div>
