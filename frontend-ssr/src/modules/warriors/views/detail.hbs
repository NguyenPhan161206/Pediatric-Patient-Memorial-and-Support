<!-- Interactive Client-side Script -->
<script>
  function openWishModal(wishId, wishTitle) {
    const modal = document.getElementById('modal-wish');
    const titleEl = document.getElementById('modal-wish-title');
    const form = document.getElementById('form-sponsor-wish');

    titleEl.textContent = wishTitle;
    form.action = `/donations/wishes/${wishId}/sponsor`;
    modal.classList.remove('hidden');
  }

  document.addEventListener('DOMContentLoaded', function() {
    // Candle Lighting
    const candleBtn = document.getElementById('btn-light-candle');
    const candleCountSpan = document.getElementById('candle-count');
    const candleFeedback = document.getElementById('candle-feedback');

    if (candleBtn) {
      candleBtn.addEventListener('click', async function() {
        const warriorId = candleBtn.getAttribute('data-id');
        candleBtn.disabled = true;
        candleBtn.classList.add('opacity-75', 'cursor-not-allowed');

        try {
          const response = await fetch(`/warriors/${warriorId}/candle`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            }
          });

          const resData = await response.json();
          if (resData && (resData.status === 'success' || resData.success)) {
            const count = resData.data ? resData.data.candleCount : (resData.candles_count || resData.candle_count);
            if (count !== undefined) {
              candleCountSpan.textContent = count;
            }
            candleFeedback.classList.remove('hidden');
            setTimeout(() => {
              candleFeedback.classList.add('hidden');
            }, 3000);
          }
        } catch (err) {
          console.error('Lỗi khi thắp nến:', err);
        } finally {
          candleBtn.disabled = false;
          candleBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        }
      });
    }
  });
</script>
