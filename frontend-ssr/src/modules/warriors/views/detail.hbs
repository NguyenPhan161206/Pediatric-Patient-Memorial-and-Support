<div class="py-8 bg-slate-50 min-h-[calc(100vh-4rem)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Breadcrumb & Back -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <a href="/warriors" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Quay lại danh sách chiến binh
      </a>

      <!-- Quick Jump Navigation -->
      <div class="flex items-center gap-2 text-xs">
        <a href="#wishes" class="px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-600 hover:text-amber-600 hover:border-amber-300 font-medium transition-colors">
          ⭐ Cây Điều Ước ({{wishes.length}})
        </a>
        <a href="#wall-of-honor" class="px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-600 hover:text-emerald-600 hover:border-emerald-300 font-medium transition-colors">
          🏆 Bức Tường Vinh Danh ({{donations.length}})
        </a>
        <a href="#tributes" class="px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-600 hover:text-rose-600 hover:border-rose-300 font-medium transition-colors">
          💌 Lời Chúc ({{tributes.length}})
        </a>
      </div>
    </div>

    <!-- Flash Notifications -->
    {{#if donationSuccess}}
      <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold mb-6 flex items-start gap-2 shadow-sm animate-fade-in">
        <span class="text-base">🎉</span>
        <div>{{donationSuccess}}</div>
      </div>
    {{/if}}

    {{#if wishSuccess}}
      <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs font-semibold mb-6 flex items-start gap-2 shadow-sm animate-fade-in">
        <span class="text-base">🎁</span>
        <div>{{wishSuccess}}</div>
      </div>
    {{/if}}

    {{#if successMessage}}
      <div class="p-4 rounded-2xl bg-sky-50 border border-sky-200 text-sky-800 text-xs font-semibold mb-6 flex items-start gap-2 shadow-sm">
        <span class="text-base">💌</span>
        <div>{{successMessage}}</div>
      </div>
    {{/if}}

    <!-- Hero Card Profile -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8 mb-8">
      <div class="flex flex-col md:flex-row gap-6 md:gap-8 items-start">
        
        <!-- Avatar -->
        <div class="relative shrink-0 w-32 h-32 sm:w-44 sm:h-44 rounded-2xl overflow-hidden bg-slate-100 border-2 border-white shadow-md">
          <img
            src="{{warrior.avatar_url}}"
            alt="{{warrior.full_name}}"
            class="w-full h-full object-cover"
            onerror="this.src='https://images.unsplash.com/photo-1544717305-2782549b5136?w=600&auto=format&fit=crop&q=80'"
          />
        </div>

        <!-- Bio & Title -->
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            <!-- Status Badge -->
            {{#if (eq warrior.status "URGENT")}}
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-600 text-white shadow-sm shadow-rose-500/30">
                <span class="h-2 w-2 rounded-full bg-white animate-ping"></span>
                Cần Hỗ Trợ Khẩn Cấp
              </span>
            {{else if (eq warrior.status "FIGHTER")}}
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-sky-100 text-sky-800 border border-sky-200">
                Đang Chiến Đấu Tích Cực
              </span>
            {{else if (eq warrior.status "RECOVERED")}}
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200">
                Đã Hồi Phục Kỳ Diệu
              </span>
            {{else if (eq warrior.status "ANGEL")}}
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-800 border border-purple-200">
                Thiên Thần Nhỏ
              </span>
            {{/if}}

            <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 text-slate-700">
              {{warrior.category_name}}
            </span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            {{warrior.full_name}}
            {{#if warrior.nickname}}
              <span class="text-rose-600 font-normal text-xl sm:text-2xl">({{warrior.nickname}})</span>
            {{/if}}
          </h1>

          <!-- Meta Grid -->
          <div class="mt-3 grid grid-cols-2 sm:grid-cols-3 gap-y-2 gap-x-4 text-xs text-slate-600">
            <div>
              <span class="text-slate-400 block">Quê quán:</span>
              <strong class="text-slate-800">{{warrior.hometown}}</strong>
            </div>
            <div>
              <span class="text-slate-400 block">Nơi điều trị:</span>
              <strong class="text-teal-700 font-bold flex items-center gap-1">
                <span>🏥</span> {{#if warrior.organization_name}}{{warrior.organization_name}}{{else}}Cơ sở y tế điều trị{{/if}}
              </strong>
            </div>
            <div>
              <span class="text-slate-400 block">Khu vực:</span>
              <strong class="text-slate-800">{{#if warrior.organization_province}}{{warrior.organization_province}}{{else}}{{warrior.hometown}}{{/if}}</strong>
            </div>
          </div>

          <!-- Candle lighting interactive box -->
          <div class="mt-6 pt-5 border-t border-slate-100 flex flex-wrap items-center gap-4">
            <button
              id="btn-light-candle"
              data-id="{{warrior.id}}"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-gradient-to-r from-amber-500 to-rose-500 hover:from-amber-600 hover:to-rose-600 text-white shadow-md shadow-rose-500/20 active:scale-95 transition-all cursor-pointer"
            >
              <span class="text-base">🕯️</span>
              <span>Thắp một ngọn nến hy vọng</span>
            </button>

            <div class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs font-semibold">
              <span class="text-base">✨</span>
              <span>Đã có <span id="candle-count" class="font-extrabold text-rose-600 text-sm">{{warrior.candle_count}}</span> ngọn nến được thắp</span>
            </div>

            <span id="candle-feedback" class="text-xs text-emerald-600 font-medium hidden">
              ✓ Đã thắp nến thành công!
            </span>
          </div>

        </div>

      </div>
    </div>

    <!-- Main Content Layout (2 Columns) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <!-- Left Column (Story, Wishes, Wall of Honor, Gallery, Tributes) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Story Card -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
          {{#if warrior.dream_summary}}
            <div class="p-4 rounded-xl bg-rose-50/60 border-l-4 border-rose-500 mb-6">
              <span class="text-xs font-bold uppercase tracking-wider text-rose-700 block mb-1">Ước mơ của con</span>
              <p class="text-sm font-medium text-slate-800 italic">
                "{{warrior.dream_summary}}"
              </p>
            </div>
          {{/if}}

          <h2 class="text-xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span>📖</span> Nhật Ký & Hành Trình Của Con
          </h2>

          <div class="prose prose-slate max-w-none text-slate-700 text-sm leading-relaxed">
            {{{warrior.story_html}}}
          </div>
        </div>

        <!-- 🌟 FEATURE 1: CÂY ĐIỀU ƯỚC TRỰC TUYẾN (WISHES) -->
        <div id="wishes" class="scroll-mt-20 bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 pb-3 border-b border-slate-100">
            <div>
              <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                <span>🌟</span> Cây Điều Ước Của Bé
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">
                Những mong ước giản dị nhưng thắp sáng niềm tin để con kiên cường chiến đấu.
              </p>
            </div>
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200 self-start sm:self-auto">
              {{wishes.length}} điều ước
            </span>
          </div>

          {{#if wishes.length}}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {{#each wishes}}
                <div class="p-5 rounded-2xl bg-gradient-to-b from-amber-50/30 via-white to-slate-50 border border-amber-200/60 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2.5">
                      <span class="text-[10px] font-bold uppercase tracking-wider text-amber-700 bg-amber-100/70 px-2 py-0.5 rounded-md">
                        {{this.category}}
                      </span>
                      {{#if (eq this.status "FULFILLED")}}
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                          <span>✓</span> Đã Thành Hiện Thực
                        </span>
                      {{else if (eq this.status "PROMISED")}}
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-sky-700 bg-sky-50 px-2.5 py-0.5 rounded-full border border-sky-200">
                          <span>🎁</span> Đang Chuẩn Bị
                        </span>
                      {{else}}
                        <span class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-700 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200">
                          <span>⭐</span> Chờ Trao Tặng
                        </span>
                      {{/if}}
                    </div>

                    <h4 class="text-sm font-bold text-slate-900 mb-1.5 leading-snug">
                      {{this.wish_title}}
                    </h4>
                    <p class="text-xs text-slate-600 leading-relaxed mb-4">
                      {{this.description}}
                    </p>
                  </div>

                  <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                    <div>
                      <span class="text-[10px] text-slate-400 block">Ước tính giá trị:</span>
                      <strong class="text-xs font-bold text-emerald-700 font-mono">
                        {{formatMoney this.estimated_cost}}
                      </strong>
                    </div>

                    {{#if (eq this.status "PENDING")}}
                      <button
                        type="button"
                        onclick="openWishModal('{{this.id}}', '{{this.wish_title}}')"
                        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-amber-500 to-rose-500 hover:from-amber-600 hover:to-rose-600 shadow-sm shadow-rose-500/20 active:scale-95 transition-all cursor-pointer"
                      >
                        <span>Nhận Trao Tặng</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                      </button>
                    {{else if (eq this.status "PROMISED")}}
                      <div class="text-right">
                        <span class="text-[10px] text-slate-400 block">Được nhận bởi:</span>
                        <span class="text-xs font-semibold text-slate-700">{{this.sponsor_name}}</span>
                      </div>
                    {{else if (eq this.status "FULFILLED")}}
                      <div class="text-right text-emerald-600 text-xs font-semibold flex items-center gap-1">
                        <span>💖</span> Đã trao tận tay
                      </div>
                    {{/if}}
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <div class="p-8 text-center bg-slate-50 rounded-2xl border border-slate-100 text-xs text-slate-400">
              Hiện chưa có điều ước nào được ghi lại cho bé.
            </div>
          {{/if}}
        </div>

        <!-- 🏆 FEATURE 2: BỨC TƯỜNG VINH DANH (WALL OF HONOR) & CHỨNG NHẬN SỐ -->
        <div id="wall-of-honor" class="scroll-mt-20 bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-3 border-b border-slate-100">
            <div>
              <h2 class="text-xl font-bold text-slate-900 flex items-center gap-2">
                <span>🏆</span> Bức Tường Vinh Danh Tấm Lòng Vàng
              </h2>
              <p class="text-xs text-slate-500 mt-0.5">
                Ghi nhận các tấm lòng vàng đã bảo trợ trực tiếp viện phí & tiếp sức cho bé.
              </p>
            </div>

            <!-- Total Verified Badge -->
            <div class="p-2 px-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 text-white shadow-sm flex items-center gap-2 self-start sm:self-auto">
              <span class="text-sm">💎</span>
              <div>
                <span class="text-[10px] uppercase font-bold text-emerald-100 block leading-none">Tổng viện phí đã đối soát</span>
                <strong class="text-sm font-extrabold font-mono tracking-tight">{{formatMoney totalDonated}}</strong>
              </div>
            </div>
          </div>

          {{#if donations.length}}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {{#each donations}}
                <div class="p-4 rounded-2xl bg-gradient-to-br from-amber-50/40 via-white to-emerald-50/20 border border-amber-200/70 shadow-sm flex flex-col justify-between hover:border-amber-300 transition-colors">
                  <div>
                    <div class="flex items-start justify-between gap-2 mb-2">
                      <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-amber-400 to-rose-400 text-white flex items-center justify-center font-bold text-xs shadow-sm">
                          💛
                        </div>
                        <div>
                          <strong class="text-xs font-bold text-slate-900 block">
                            {{#if this.is_anonymous}}Nhà Hảo Tâm Ẩn Danh{{else}}{{this.donor_name}}{{/if}}
                          </strong>
                          <span class="text-[10px] text-slate-400">{{formatDate this.verified_at}}</span>
                        </div>
                      </div>

                      <span class="text-xs font-extrabold text-emerald-700 font-mono bg-emerald-50 px-2 py-0.5 rounded-lg border border-emerald-200">
                        {{formatMoney this.amount}}
                      </span>
                    </div>

                    {{#if this.transfer_message}}
                      <div class="p-2.5 rounded-xl bg-white/80 border border-slate-100 text-xs text-slate-600 italic mb-3">
                        "{{this.transfer_message}}"
                      </div>
                    {{/if}}
                  </div>

                  <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs">
                    <span class="text-[10px] font-mono text-slate-400 truncate max-w-[140px]" title="{{this.certificate_code}}">
                      {{this.certificate_code}}
                    </span>

                    <!-- Certificate Button with QR Link -->
                    <a
                      href="/donations/cert/{{this.certificate_qr_token}}"
                      target="_blank"
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-bold text-amber-900 bg-amber-100 hover:bg-amber-200 border border-amber-300 transition-colors cursor-pointer"
                    >
                      <span>Xem Chứng Nhận</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
            <div class="p-8 text-center bg-slate-50 rounded-2xl border border-slate-100 text-xs text-slate-400">
              Chưa có giao dịch bảo trợ nào được hoàn tất đối soát. Bạn có thể là người đầu tiên tiếp sức cho bé!
            </div>
          {{/if}}
        </div>

        <!-- Gallery / Tranh vẽ & Kỷ vật -->
        {{#if gallery.length}}
          <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
            <h2 class="text-xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-100 flex items-center gap-2">
              <span>🎨</span> Góc Kỷ Vật & Tranh Vẽ Của Bé
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {{#each gallery}}
                <div class="group rounded-xl border border-slate-200 overflow-hidden bg-slate-50 flex flex-col">
                  <div class="h-44 bg-slate-200 overflow-hidden">
                    <img
                      src="{{this.media_url}}"
                      alt="{{this.caption}}"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      onerror="this.src='https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=600&auto=format&fit=crop&q=80'"
                    />
                  </div>
                  <div class="p-3.5 flex-1 flex flex-col justify-between">
                    <div>
                      <h4 class="text-xs font-bold text-slate-900">{{this.caption}}</h4>
                    </div>
                    <span class="mt-2 text-[10px] text-slate-400 block uppercase font-medium">{{this.media_type}}</span>
                  </div>
                </div>
              {{/each}}
            </div>
          </div>
        {{/if}}

        <!-- Bức Tường Tri Ân & Lời Nhắn Gửi -->
        <div id="tributes" class="scroll-mt-20 bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 sm:p-8">
          <h2 class="text-xl font-bold text-slate-900 mb-2 flex items-center gap-2">
            <span>💌</span> Bức Tường Lời Chúc & Tri Ân
          </h2>
          <p class="text-xs text-slate-500 mb-6">
            Mỗi lời nhắn là một đóa hoa thơm gửi trao năng lượng bình an đến con và gia đình.
          </p>

          <!-- Approved Tributes List -->
          <div class="space-y-4 mb-8">
            {{#if tributes.length}}
              {{#each tributes}}
                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-start gap-3">
                  <div class="h-8 w-8 rounded-full bg-rose-100 text-rose-600 font-bold text-xs flex items-center justify-center shrink-0">
                    {{this.sender_name.[0]}}
                  </div>
                  <div class="flex-1">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold text-slate-900">{{this.sender_name}}</span>
                      <span class="text-[10px] text-slate-400">{{formatDate this.created_at}}</span>
                    </div>
                    <p class="mt-1.5 text-xs text-slate-700 leading-relaxed">
                      {{this.content}}
                    </p>
                  </div>
                </div>
              {{/each}}
            {{else}}
              <div class="text-center py-6 text-slate-400 text-xs bg-slate-50 rounded-xl">
                Chưa có lời chúc nào được hiển thị. Hãy là người đầu tiên trao gửi yêu thương đến bé!
              </div>
            {{/if}}
          </div>

          <!-- New Tribute Form (Subject to Pre-moderation) -->
          <div class="p-5 rounded-xl bg-slate-50/80 border border-slate-200">
            <h3 class="text-sm font-bold text-slate-900 mb-1">Gửi lời chúc đến bé</h3>
            <p class="text-[11px] text-slate-500 mb-4">
              Theo quy định bảo vệ trẻ em (Luật Trẻ em 2016 & Nghị định 147/2024/NĐ-CP), lời chúc sẽ được ban quản trị và phụ huynh kiểm duyệt trước khi hiển thị công khai.
            </p>

            <form action="/warriors/{{warrior.id}}/tribute" method="POST" class="space-y-3.5">
              <input type="hidden" name="slug" value="{{warrior.slug}}" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-medium text-slate-700 mb-1">Họ và tên của bạn *</label>
                  <input
                    type="text"
                    name="sender_name"
                    required
                    placeholder="Ví dụ: Nguyễn Văn A"
                    class="w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500"
                  />
                </div>
                <div>
                  <label class="block text-xs font-medium text-slate-700 mb-1">Email của bạn (Không công khai)</label>
                  <input
                    type="email"
                    name="sender_email"
                    placeholder="email@example.com"
                    class="w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500"
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">Lời chúc yêu thương *</label>
                <textarea
                  name="content"
                  rows="3"
                  required
                  placeholder="Viết những lời động viên chân thành nhất gửi đến bé và gia đình..."
                  class="w-full px-3 py-2 text-xs bg-white border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500"
                ></textarea>
              </div>

              <button
                type="submit"
                class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg shadow-sm transition-all cursor-pointer"
              >
                <span>Gửi lời chúc</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </form>
          </div>

        </div>

