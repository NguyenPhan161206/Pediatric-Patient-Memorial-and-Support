<div class="space-y-6 max-w-4xl mx-auto">
  <!-- Header / Breadcrumbs -->
  <div>
    <div class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
      <a href="/" class="hover:text-slate-900 transition-colors">Trang chủ</a>
      <span>/</span>
      <a href="/warriors" class="hover:text-slate-900 transition-colors">Chiến Binh Nhí</a>
      <span>/</span>
      <span class="text-slate-900 font-semibold">Tạo Hồ Sơ Mới</span>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 flex items-center gap-2.5">
          <span>👶</span> Tạo Hồ Sơ Chiến Binh Nhí
        </h1>
        <p class="text-sm text-slate-500 mt-1">
          Lưu giữ câu chuyện kiên cường và kết nối yêu thương từ cộng đồng.
        </p>
      </div>

      <!-- Compliance Badge -->
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 shrink-0">
        🛡️ Tuân thủ Luật Trẻ Em 2016
      </span>
    </div>
  </div>

  {{#if errorMsg}}
    <div class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700 flex items-center gap-2 shadow-sm">
      <svg class="w-4 h-4 text-rose-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
      <span>{{errorMsg}}</span>
    </div>
  {{/if}}

  <!-- Main Create Form (shadcn/ui Form style) -->
  <form action="/warriors/new" method="POST" class="space-y-6">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- Cột 1 & 2: Thông tin nhân thân & câu chuyện của bé -->
      <div class="lg:col-span-2 space-y-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="font-bold text-sm text-slate-900 pb-2 border-b border-slate-100 flex items-center gap-2">
          <span>📝</span> Thông Tin Cơ Bản Của Bé
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Họ và tên bé *</label>
            <input 
              type="text" 
              name="full_name" 
              required 
              placeholder="Ví dụ: Nguyễn Văn An"
              class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Tên thân mật (Nickname)</label>
            <input 
              type="text" 
              name="nickname" 
              placeholder="Ví dụ: Bé Bo, Bé Bông..."
              class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Ngày sinh</label>
            <input 
              type="date" 
              name="dob" 
              class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Quê quán / Tỉnh thành</label>
            <input 
              type="text" 
              name="hometown" 
              placeholder="Ví dụ: Hà Nội, Nghệ An, Đà Nẵng..."
              class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Nhóm bệnh lý *</label>
            <select name="category_id" required class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 font-medium">
              <option value="">-- Chọn bệnh lý --</option>
              {{#each categories}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Trạng thái điều trị *</label>
            <select name="status" required class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 font-medium">
              <option value="FIGHTER" selected>🟡 Đang điều trị kiên cường (FIGHTER)</option>
              <option value="URGENT">🔴 Cần viện phí khẩn cấp (URGENT)</option>
              <option value="RECOVERED">🟢 Đã điều trị khỏi (RECOVERED)</option>
              <option value="ANGEL">🕊️ Thiên thần nhỏ (ANGEL)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Link ảnh đại diện của bé (URL ảnh chân thực)</label>
          <input 
            type="url" 
            name="avatar_url" 
            placeholder="https://images.unsplash.com/photo-..."
            class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 font-mono"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Tóm tắt ước mơ của bé</label>
          <input 
            type="text" 
            name="dream_summary" 
            placeholder="Con ước mơ sau này khỏi bệnh sẽ làm chú cảnh sát..."
            class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Câu chuyện & Nhật ký điều trị *</label>
          <textarea 
            name="story_html" 
            rows="5" 
            required
            placeholder="Chia sẻ hành trình kiên cường của bé và gia đình..."
            class="w-full rounded-lg border border-slate-200 bg-white p-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 leading-relaxed"
          ></textarea>
        </div>
      </div>

      <!-- Cột 3: Cơ sở bảo trợ & Thông tin ngân hàng đối soát -->
      <div class="space-y-4">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm space-y-4">
          <h3 class="font-bold text-sm text-slate-900 pb-2 border-b border-slate-100 flex items-center gap-2">
            <span>🏥</span> Cơ Sở & Viện Phí
          </h3>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Bệnh Viện / Tổ Chức Bảo Trợ</label>
            <select name="organization_id" class="h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 font-medium">
              {{#each organizations}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Hình Thức Tiếp Nhận Viện Phí</label>
            <select name="sponsorship_type" class="h-10 w-full rounded-lg border border-slate-200 bg-slate-50 px-3 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-900 font-medium">
              <option value="HOSPITAL" selected>🏥 Tài khoản viện phí Bệnh viện</option>
              <option value="FAMILY_GUARDIAN">👨‍👩‍👧 Tài khoản cha/mẹ ruột (Có xác minh CCCD)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Mã bệnh nhân viện phí (Nếu có)</label>
            <input 
              type="text" 
              name="hospital_patient_code" 
              placeholder="VD: BVNTW-2024-8891"
              class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 font-mono focus:outline-none focus:ring-2 focus:ring-slate-900"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Mã Ngân Hàng</label>
            <input 
              type="text" 
              name="bank_code" 
              placeholder="VD: BIDV, VCB, MB..."
              class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 font-mono uppercase focus:outline-none focus:ring-2 focus:ring-slate-900"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Số Tài Khoản</label>
            <input 
              type="text" 
              name="bank_account_number" 
              placeholder="VD: 12010000088999"
              class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 font-mono focus:outline-none focus:ring-2 focus:ring-slate-900"
            />
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">Tên Chủ Tài Khoản</label>
            <input 
              type="text" 
              name="bank_account_name" 
              placeholder="VD: BENH VIEN NHI TRUNG UONG"
              class="h-10 w-full rounded-lg border border-slate-200 bg-white px-3 text-xs text-slate-900 uppercase focus:outline-none focus:ring-2 focus:ring-slate-900"
            />
          </div>
        </div>

        <!-- Cam kết Giám hộ theo Luật Trẻ Em -->
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 space-y-3">
          <div class="flex items-start gap-2.5">
            <input 
              type="checkbox" 
              id="legal_consent" 
              name="legal_consent" 
              required 
              checked
              class="mt-0.5 rounded border-slate-300 text-rose-600 focus:ring-rose-500"
            />
            <label for="legal_consent" class="text-xs text-slate-600 leading-relaxed cursor-pointer select-none">
              Tôi xác nhận đã có sự đồng thuận bằng văn bản của cha mẹ/người giám hộ hợp pháp theo quy định của <strong>Luật Trẻ Em 2016</strong> và <strong>Nghị định 13/2023/NĐ-CP</strong> về bảo vệ dữ liệu cá nhân của trẻ em.
            </label>
          </div>

          <div class="pt-2 flex items-center justify-end gap-2">
            <a href="/warriors" class="h-10 px-4 rounded-xl border border-slate-200 bg-white text-xs font-semibold text-slate-700 hover:bg-slate-100 flex items-center justify-center transition-colors">
              Hủy
            </a>
            <button 
              type="submit" 
              class="h-10 px-5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow-sm transition-all hover:scale-[1.01]"
            >
              Xuất Bản Hồ Sơ 🚀
            </button>
          </div>
        </div>
      </div>

    </div>
  </form>
</div>
