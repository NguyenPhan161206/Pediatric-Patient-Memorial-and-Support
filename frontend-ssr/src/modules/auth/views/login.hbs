<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md space-y-6">
    
    <!-- Card Header (shadcn/ui Card style) -->
    <div class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
      <div class="text-center mb-8">
        <div class="inline-flex h-12 w-12 rounded-xl bg-rose-50 border border-rose-100 text-rose-600 items-center justify-center mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Đăng Nhập Hệ Thống</h2>
        <p class="text-sm text-slate-500 mt-1">Cổng Ký Ức & Tri Ân Các Chiến Binh Nhí</p>
      </div>

      {{#if error}}
        <div class="mb-6 rounded-lg border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700 flex items-center gap-2">
          <svg class="w-4 h-4 text-rose-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
          <span>{{error}}</span>
        </div>
      {{/if}}

      <form action="/auth/login" method="POST" class="space-y-4">
        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">Email</label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            value="{{email}}"
            required 
            placeholder="admin@warrior.org"
            class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Mật khẩu</label>
          </div>
          <input 
            type="password" 
            name="password" 
            id="password" 
            required 
            placeholder="••••••••"
            class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all"
          />
        </div>

        <button 
          type="submit" 
          class="w-full inline-flex items-center justify-center rounded-md text-sm font-semibold bg-slate-900 text-white hover:bg-slate-800 h-10 px-4 shadow-sm transition-all hover:scale-[1.01]"
        >
          Đăng Nhập
        </button>
      </form>

      <!-- Gợi ý tài khoản mẫu -->
      <div class="mt-8 pt-6 border-t border-slate-100">
        <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Tài Khoản Kiểm Thử Mẫu (Mật khẩu: Password@2026):</h4>
        <div class="space-y-1.5 text-xs text-slate-600 bg-slate-50 p-3 rounded-lg border border-slate-200/60 font-mono">
          <div class="flex justify-between items-center cursor-pointer hover:text-rose-600" onclick="fillCreds('admin@warrior.org')">
            <span>👑 Super Admin:</span>
            <span class="font-bold underline">admin@warrior.org</span>
          </div>
          <div class="flex justify-between items-center cursor-pointer hover:text-amber-600" onclick="fillCreds('family.minhan@gmail.com')">
            <span>👨‍👩‍👧 Mẹ Bé Minh An:</span>
            <span class="font-bold underline">family.minhan@gmail.com</span>
          </div>
          <div class="flex justify-between items-center cursor-pointer hover:text-indigo-600" onclick="fillCreds('coordinator@warrior.org')">
            <span>🩺 Điều Phối Viên:</span>
            <span class="font-bold underline">coordinator@warrior.org</span>
          </div>
        </div>
      </div>

      <div class="mt-6 text-center text-xs text-slate-500">
        Chưa có tài khoản? 
        <a href="/auth/register" class="font-semibold text-rose-600 hover:text-rose-700 underline">Đăng ký thành viên</a>
      </div>

    </div>

  </div>
</div>

<script>
  function fillCreds(email) {
    document.getElementById('email').value = email;
    document.getElementById('password').value = 'Password@2026';
  }
</script>
