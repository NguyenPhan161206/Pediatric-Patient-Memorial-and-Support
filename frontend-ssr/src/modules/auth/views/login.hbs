<div class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-md space-y-6">
    
    <!-- Card Header (shadcn/ui Card style) -->
    <div class="rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
      <div class="text-center mb-8">
        <div class="inline-flex h-12 w-12 rounded-xl bg-rose-50 border border-rose-100 text-rose-600 items-center justify-center mb-3">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Đăng Nhập Hệ Thống</h2>
        <p class="text-sm text-slate-500 mt-1">Cổng Ký Ức & Tri Ân Các Chiến Binh Nhí</p>
      </div>

      {{#if error}}
        <div class="mb-6 rounded-lg border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700 flex items-center gap-2">
          <svg class="w-4 h-4 text-rose-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
          <span>{{error}}</span>
        </div>
      {{/if}}

      <form action="/auth/login" method="POST" class="space-y-4">
        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1.5">Email</label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            value="{{email}}"
            required 
            placeholder="admin@warrior.org"
            class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-slate-700">Mật khẩu</label>
          </div>
          <input 
            type="password" 
            name="password" 
            id="password" 
            required 
            placeholder="••••••••"
            class="flex h-10 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-slate-900 focus:border-transparent transition-all"
          />
        </div>

        <button 
          type="submit" 
          class="w-full inline-flex items-center justify-center rounded-md text-sm font-semibold bg-slate-900 text-white hover:bg-slate-800 h-10 px-4 shadow-sm transition-all hover:scale-[1.01]"
        >
          Đăng Nhập
        </button>
      </form>

      <!-- Gợi ý tài khoản mẫu theo từng Role (1-Click Fill) -->
      <div class="mt-8 pt-6 border-t border-slate-100">
        <div class="flex items-center justify-between mb-3">
          <h4 class="text-xs font-semibold text-slate-700 uppercase tracking-wider">Tài Khoản Kiểm Thử (1-Click Fill)</h4>
          <span class="text-[11px] font-mono bg-slate-100 text-slate-600 px-2 py-0.5 rounded">Pass: Password@2026</span>
        </div>

        <div class="space-y-3 text-xs">
          <!-- Role Quản trị -->
          <div>
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Quản Trị Viên (System Admin)</div>
            <div class="grid grid-cols-2 gap-1.5">
              <button type="button" onclick="fillCreds('superadmin@warrior.org')" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg border border-purple-200 bg-purple-50/50 hover:bg-purple-100/70 text-purple-900 transition-colors text-left">
                <span class="font-medium truncate">👑 Super Admin</span>
                <span class="text-[10px] font-mono text-purple-600 ml-1 shrink-0">Điền</span>
              </button>
              <button type="button" onclick="fillCreds('admin@warrior.org')" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg border border-rose-200 bg-rose-50/50 hover:bg-rose-100/70 text-rose-900 transition-colors text-left">
                <span class="font-medium truncate">🛡️ System Admin</span>
                <span class="text-[10px] font-mono text-rose-600 ml-1 shrink-0">Điền</span>
              </button>
            </div>
          </div>

          <!-- Role Bệnh viện / Quỹ -->
          <div>
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Bệnh Viện & Quỹ (ORG_ADMIN)</div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-1.5">
              <button type="button" onclick="fillCreds('orgadmin.nhi@warriorhub.vn')" class="flex items-center justify-between px-2 py-1.5 rounded-lg border border-blue-200 bg-blue-50/50 hover:bg-blue-100/70 text-blue-900 transition-colors text-left">
                <span class="font-medium truncate">🏥 BV Nhi TW</span>
                <span class="text-[10px] font-mono text-blue-600 ml-1 shrink-0">Điền</span>
              </button>
              <button type="button" onclick="fillCreds('orgadmin.k@warriorhub.vn')" class="flex items-center justify-between px-2 py-1.5 rounded-lg border border-emerald-200 bg-emerald-50/50 hover:bg-emerald-100/70 text-emerald-900 transition-colors text-left">
                <span class="font-medium truncate">🏥 BV K Tân Triều</span>
                <span class="text-[10px] font-mono text-emerald-600 ml-1 shrink-0">Điền</span>
              </button>
              <button type="button" onclick="fillCreds('orgadmin.nucuoiem@warriorhub.vn')" class="flex items-center justify-between px-2 py-1.5 rounded-lg border border-amber-200 bg-amber-50/50 hover:bg-amber-100/70 text-amber-900 transition-colors text-left">
                <span class="font-medium truncate">🎗️ Quỹ Nụ Cười Em</span>
                <span class="text-[10px] font-mono text-amber-600 ml-1 shrink-0">Điền</span>
              </button>
            </div>
          </div>

          <!-- Role Điều phối & Nhà hảo tâm -->
          <div>
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Điều Phối & Nhà Hảo Tâm</div>
            <div class="grid grid-cols-2 gap-1.5">
              <button type="button" onclick="fillCreds('coordinator@warrior.org')" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg border border-indigo-200 bg-indigo-50/50 hover:bg-indigo-100/70 text-indigo-900 transition-colors text-left">
                <span class="font-medium truncate">🩺 Điều Phối Viên</span>
                <span class="text-[10px] font-mono text-indigo-600 ml-1 shrink-0">Điền</span>
              </button>
              <button type="button" onclick="fillCreds('supporter@gmail.com')" class="flex items-center justify-between px-2.5 py-1.5 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-800 transition-colors text-left">
                <span class="font-medium truncate">💖 Nhà Hảo Tâm</span>
                <span class="text-[10px] font-mono text-slate-500 ml-1 shrink-0">Điền</span>
              </button>
            </div>
          </div>

          <!-- Role Gia đình bệnh nhi -->
          <div>
            <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-1">Gia Đình Chiến Binh (FAMILY)</div>
            <div class="grid grid-cols-2 gap-1.5">
              <button type="button" onclick="fillCreds('family.minhan@gmail.com')" class="flex items-center justify-between px-2 py-1.5 rounded-lg border border-amber-200 bg-amber-50/40 hover:bg-amber-100/60 text-amber-900 transition-colors text-left">
                <span class="font-medium truncate">👨‍👩‍👦 Mẹ Bé Minh An</span>
                <span class="text-[10px] font-mono text-amber-600 shrink-0">Điền</span>
              </button>
              <button type="button" onclick="fillCreds('family.maichi@gmail.com')" class="flex items-center justify-between px-2 py-1.5 rounded-lg border border-amber-200 bg-amber-50/40 hover:bg-amber-100/60 text-amber-900 transition-colors text-left">
                <span class="font-medium truncate">👨‍👧 Bố Bé Mai Chi</span>
                <span class="text-[10px] font-mono text-amber-600 shrink-0">Điền</span>
              </button>
              <button type="button" onclick="fillCreds('family.tuankiet@gmail.com')" class="flex items-center justify-between px-2 py-1.5 rounded-lg border border-emerald-200 bg-emerald-50/40 hover:bg-emerald-100/60 text-emerald-900 transition-colors text-left">
                <span class="font-medium truncate">👨‍👦 Bố Bé Tuấn Kiệt</span>
                <span class="text-[10px] font-mono text-emerald-600 shrink-0">Điền</span>
              </button>
              <button type="button" onclick="fillCreds('family.thienan@gmail.com')" class="flex items-center justify-between px-2 py-1.5 rounded-lg border border-sky-200 bg-sky-50/40 hover:bg-sky-100/60 text-sky-900 transition-colors text-left">
                <span class="font-medium truncate">🕊️ Mẹ Bé Thiên Ân</span>
                <span class="text-[10px] font-mono text-sky-600 shrink-0">Điền</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 text-center text-xs text-slate-500">
        Chưa có tài khoản? 
        <a href="/auth/register" class="font-semibold text-rose-600 hover:text-rose-700 underline">Đăng ký thành viên</a>
      </div>

    </div>

  </div>
</div>

<script>
  function fillCreds(email) {
    document.getElementById('email').value = email;
    document.getElementById('password').value = 'Password@2026';
  }
</script>
