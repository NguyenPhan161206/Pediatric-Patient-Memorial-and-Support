<div class="min-h-[85vh] flex items-center justify-center py-10 px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-xl space-y-6">
    
    <div class="rounded-2xl border border-slate-200/80 bg-white p-8 shadow-sm">
      <div class="text-center mb-8">
        <div class="inline-flex h-12 w-12 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 items-center justify-center mb-3 shadow-inner">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
        </div>
        <h2 class="text-2xl font-black tracking-tight text-slate-900">Đăng Ký Thành Viên</h2>
        <p class="text-xs text-slate-500 mt-1.5">Chuẩn hóa danh tính đa thành tố & bảo vệ dữ liệu theo Nghị định 13/2023/NĐ-CP</p>
      </div>

      {{#if error}}
        <div class="mb-6 rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs text-rose-700 flex items-center gap-2.5">
          <svg class="w-4 h-4 text-rose-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
          <span class="font-medium">{{error}}</span>
        </div>
      {{/if}}

      <form action="/auth/register" method="POST" class="space-y-5" id="registerForm">
        
        <!-- NHÓM 1: GIỚI TÍNH & HỌC VỊ / DANH XƯNG CHUYÊN MÔN -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-3.5 rounded-xl bg-slate-50/70 border border-slate-200/80">
          <div>
            <label for="gender" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
              Giới tính (Tiền tố xưng hô) <span class="text-rose-500">*</span>
            </label>
            <select 
              name="gender" 
              id="gender" 
              class="identity-input flex h-10 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all cursor-pointer"
            >
              <option value="MALE" selected>Nam (Ông / Anh - Mr.)</option>
              <option value="FEMALE">Nữ (Bà / Chị - Mrs./Ms.)</option>
              <option value="OTHER">Khác (Bạn - Mx.)</option>
              <option value="UNSPECIFIED">Không xác định</option>
            </select>
          </div>

          <div>
            <label for="title_prefix" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
              Học vị / Danh xưng (Tùy chọn)
            </label>
            <input 
              type="text" 
              name="title_prefix" 
              id="title_prefix" 
              placeholder="VD: BS., ThS., TS., CN., ..."
              value="{{formData.title_prefix}}"
              class="identity-input flex h-10 w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm placeholder:text-slate-400 font-medium focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all"
            />
          </div>
        </div>

        <!-- NHÓM 2: 3 THÀNH TỐ TÊN PHÂN TÁCH -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Họ và Tên (3 Thành Tố Độc Lập)</label>
            <span class="text-[10px] text-slate-400">Chuẩn danh tính VN</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
            <div>
              <label for="last_name" class="block text-[11px] font-medium text-slate-500 mb-1">Họ <span class="text-rose-500">*</span></label>
              <input 
                type="text" 
                name="last_name" 
                id="last_name" 
                required 
                placeholder="Nguyễn"
                value="{{formData.last_name}}"
                class="identity-input flex h-10 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all font-medium"
              />
            </div>

            <div>
              <label for="middle_name" class="block text-[11px] font-medium text-slate-500 mb-1">Tên đệm / lót</label>
              <input 
                type="text" 
                name="middle_name" 
                id="middle_name" 
                placeholder="Văn"
                value="{{formData.middle_name}}"
                class="identity-input flex h-10 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all font-medium"
              />
            </div>

            <div>
              <label for="first_name" class="block text-[11px] font-medium text-slate-500 mb-1">Tên chính <span class="text-rose-500">*</span></label>
              <input 
                type="text" 
                name="first_name" 
                id="first_name" 
                required 
                placeholder="An"
                value="{{formData.first_name}}"
                class="identity-input flex h-10 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all font-medium"
              />
            </div>
          </div>
        </div>

        <!-- NHÓM 3: TÙY BIẾN ẨN / HIỆN THÀNH TỐ & CHẾ ĐỘ HIỂN THỊ -->
        <div class="rounded-xl border border-slate-200/90 bg-slate-50/60 p-4 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
              <span>🛡️ Tùy Biến Hiển Thị Danh Tính Công Khai</span>
            </span>
            <span class="text-[10px] text-indigo-600 font-semibold bg-indigo-50 px-2 py-0.5 rounded-full border border-indigo-100">Nghị định 13</span>
          </div>

          <!-- Bật / tắt hiển thị tiền tố & học vị -->
          <div class="flex flex-wrap items-center gap-4 text-xs text-slate-700 pt-1">
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" name="include_prefix_in_display" id="include_prefix_in_display" class="rounded text-rose-600 focus:ring-rose-500">
              <span>Hiện tiền tố xưng hô (Ông/Bà/Mr/Mrs)</span>
            </label>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" name="include_title_in_display" id="include_title_in_display" checked class="rounded text-rose-600 focus:ring-rose-500">
              <span>Hiện học vị chuyên môn (nếu có)</span>
            </label>
          </div>

          <!-- Các chế độ hiển thị tên chính -->
          <div class="grid grid-cols-2 gap-2 text-xs pt-1">
            <label class="flex items-center gap-2 p-2 rounded-lg border border-slate-200 bg-white hover:border-rose-300 cursor-pointer transition-all">
              <input type="radio" name="display_mode" value="FULL_NAME" checked class="text-rose-600 focus:ring-rose-500">
              <div>
                <strong class="block font-semibold text-slate-800">Đầy đủ Họ & Tên</strong>
                <span class="text-[10px] text-slate-400">Hiện rõ họ tên</span>
              </div>
            </label>

            <label class="flex items-center gap-2 p-2 rounded-lg border border-slate-200 bg-white hover:border-rose-300 cursor-pointer transition-all">
              <input type="radio" name="display_mode" value="HIDE_LAST_NAME" class="text-rose-600 focus:ring-rose-500">
              <div>
                <strong class="block font-semibold text-slate-800">Ẩn họ</strong>
                <span class="text-[10px] text-slate-400">Chỉ hiện Đệm + Tên</span>
              </div>
            </label>

            <label class="flex items-center gap-2 p-2 rounded-lg border border-slate-200 bg-white hover:border-rose-300 cursor-pointer transition-all">
              <input type="radio" name="display_mode" value="ABBREVIATED" class="text-rose-600 focus:ring-rose-500">
              <div>
                <strong class="block font-semibold text-slate-800">Viết tắt bảo mật</strong>
                <span class="text-[10px] text-slate-400">Họ + T. Đ. T.</span>
              </div>
            </label>

            <label class="flex items-center gap-2 p-2 rounded-lg border border-slate-200 bg-white hover:border-rose-300 cursor-pointer transition-all">
              <input type="radio" name="display_mode" value="ANONYMOUS" class="text-rose-600 focus:ring-rose-500">
              <div>
                <strong class="block font-semibold text-slate-800">Ẩn danh</strong>
                <span class="text-[10px] text-slate-400">Bảo mật tuyệt đối</span>
              </div>
            </label>
          </div>

          <!-- BILINGUAL REAL-TIME LIVE PREVIEW BOX -->
          <div class="mt-3 pt-3 border-t border-slate-200/80 space-y-2 text-xs">
            <div class="flex items-center justify-between">
              <span class="text-slate-500 font-medium">🇻🇳 Hiển thị Tiếng Việt:</span>
              <div class="font-bold text-rose-700 bg-rose-50/80 px-2.5 py-1 rounded-md border border-rose-100 flex items-center gap-1.5">
                <span>👤</span>
                <span id="previewTextVi">Nguyễn Văn An</span>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-500 font-medium">🇬🇧 English Translation (i18n):</span>
              <div class="font-bold text-slate-800 bg-slate-100 px-2.5 py-1 rounded-md border border-slate-200 flex items-center gap-1.5">
                <span>🌐</span>
                <span id="previewTextEn">Mr. An Nguyen</span>
              </div>
            </div>
          </div>
        </div>

        <!-- NHÓM 4: EMAIL, SỐ ĐIỆN THOẠI & MẬT KHẨU -->
        <div>
          <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Email <span class="text-rose-500">*</span></label>
          <input 
            type="email" 
            name="email" 
            id="email" 
            required 
            placeholder="you@example.com"
            value="{{formData.email}}"
            class="flex h-10 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all font-medium"
          />
        </div>

        <div>
          <label for="phone_number" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Số điện thoại (tùy chọn)</label>
          <input 
            type="tel" 
            name="phone_number" 
            id="phone_number" 
            placeholder="0912345678"
            value="{{formData.phone_number}}"
            class="flex h-10 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all font-medium"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Mật khẩu <span class="text-rose-500">*</span></label>
          <input 
            type="password" 
            name="password" 
            id="password" 
            required 
            placeholder="Tối thiểu 6 ký tự"
            class="flex h-10 w-full rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2 text-sm placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500 transition-all font-medium"
          />
        </div>

        <button 
          type="submit" 
          class="w-full inline-flex items-center justify-center gap-2 rounded-xl text-sm font-bold bg-gradient-to-r from-rose-600 to-rose-700 text-white hover:from-rose-700 hover:to-rose-800 h-11 px-4 shadow-md shadow-rose-600/20 transition-all hover:scale-[1.01] active:scale-[0.99] cursor-pointer"
        >
          <span>✨</span>
          <span>Đăng Ký Tài Khoản Thành Viên</span>
        </button>
      </form>

      <div class="mt-6 text-center text-xs text-slate-500 border-t border-slate-100 pt-4">
        Đã có tài khoản? 
        <a href="/auth/login" class="font-bold text-rose-600 hover:text-rose-700 underline">Đăng nhập ngay</a>
      </div>

    </div>

  </div>
</div>

<script>
  // Bilingual Real-time Live Preview Engine for Multi-Attribute User Identity
  (function() {
    const genderSelect = document.getElementById('gender');
    const titleInput = document.getElementById('title_prefix');
    const lastNameInput = document.getElementById('last_name');
    const middleNameInput = document.getElementById('middle_name');
    const firstNameInput = document.getElementById('first_name');
    const prefixCheckbox = document.getElementById('include_prefix_in_display');
    const titleCheckbox = document.getElementById('include_title_in_display');
    const modeRadios = document.querySelectorAll('input[name="display_mode"]');

    const previewTextVi = document.getElementById('previewTextVi');
    const previewTextEn = document.getElementById('previewTextEn');

    function updatePreview() {
      const gender = genderSelect.value || 'MALE';
      const title = (titleInput.value || '').trim();
      const lastName = (lastNameInput.value || '').trim();
      const middleName = (middleNameInput.value || '').trim();
      const firstName = (firstNameInput.value || '').trim();
      const showPrefix = prefixCheckbox.checked;
      const showTitle = titleCheckbox.checked;

      const selectedMode = document.querySelector('input[name="display_mode"]:checked')?.value || 'FULL_NAME';

      if (selectedMode === 'ANONYMOUS') {
        previewTextVi.textContent = 'Nhà hảo tâm ẩn danh';
        previewTextEn.textContent = 'Anonymous Supporter';
        return;
      }

      // 1. Phân loại Họ tên tiếng Việt
      let viName = [lastName, middleName, firstName].filter(Boolean).join(' ') || 'Nguyễn Văn An';
      if (selectedMode === 'HIDE_LAST_NAME') {
        viName = [middleName, firstName].filter(Boolean).join(' ') || firstName || 'Văn An';
      } else if (selectedMode === 'ABBREVIATED') {
        const midInit = middleName ? middleName.split(/\s+/).map(w => w[0].toUpperCase() + '.').join(' ') : '';
        const firstInit = firstName ? firstName[0].toUpperCase() + '.' : '';
        viName = [lastName, midInit, firstInit].filter(Boolean).join(' ') || 'Nguyễn V. A.';
      } else if (selectedMode === 'FIRST_NAME_ONLY') {
        viName = firstName || 'An';
      }

      // Tiền tố tiếng Việt
      let viSalutation = '';
      if (showPrefix) {
        if (gender === 'MALE') viSalutation = 'Ông';
        else if (gender === 'FEMALE') viSalutation = 'Bà';
        else if (gender === 'OTHER') viSalutation = 'Bạn';
      }

      let viTitle = (showTitle && title) ? title : '';
      previewTextVi.textContent = [viSalutation, viTitle, viName].filter(Boolean).join(' ');

      // 2. English Version
      let enSalutation = '';
      if (gender === 'MALE') enSalutation = 'Mr.';
      else if (gender === 'FEMALE') enSalutation = 'Mrs.';
      else if (gender === 'OTHER') enSalutation = 'Mx.';

      let enTitle = (showTitle && title) ? title : '';
      let enName = `${firstName || 'An'} ${lastName || 'Nguyen'}`;
      if (selectedMode === 'FIRST_NAME_ONLY') enName = firstName || 'An';

      previewTextEn.textContent = [enSalutation, enTitle, enName].filter(Boolean).join(' ');
    }

    [genderSelect, titleInput, lastNameInput, middleNameInput, firstNameInput, prefixCheckbox, titleCheckbox].forEach(el => {
      if (el) {
        el.addEventListener('input', updatePreview);
        el.addEventListener('change', updatePreview);
      }
    });

    modeRadios.forEach(r => r.addEventListener('change', updatePreview));

    updatePreview();
  })();
</script>
