<div class="py-8 bg-slate-50 min-h-[calc(100vh-4rem)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header & Breadcrumb -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2 text-xs text-slate-500 mb-1">
          <a href="/" class="hover:text-slate-900">Trang chủ</a>
          <span>/</span>
          <span class="text-slate-800 font-semibold">Đối Soát & Cấp Chứng Nhận</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2.5">
          <span>🛡️</span> Cổng Duyệt Biên Lai Chuyển Khoản
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">
            {{totalPending}} chờ duyệt
          </span>
        </h1>
        <p class="text-xs text-slate-500 mt-1">
          Dành cho Bệnh Viện (ORG_ADMIN), Gia Đình (FAMILY) và Quản Trị Viên (ADMIN) đối soát tài khoản thụ hưởng và kích hoạt Chứng Nhận Tri Ân Số.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href="/warriors"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 shadow-sm transition-all"
        >
          <span>Xem Danh Sách Bé</span>
        </a>
      </div>
    </div>

    <!-- Flash Notifications -->
    {{#if modSuccess}}
      <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold mb-6 flex items-start gap-2 shadow-sm">
        <span class="text-base">✓</span>
        <div>{{modSuccess}}</div>
      </div>
    {{/if}}

    {{#if modError}}
      <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-semibold mb-6 flex items-start gap-2 shadow-sm">
        <span class="text-base">⚠️</span>
        <div>{{modError}}</div>
      </div>
    {{/if}}

    <!-- Regulations Guidance Banner -->
    <div class="p-4 rounded-2xl bg-gradient-to-r from-teal-50 to-emerald-50 border border-teal-200/80 text-xs text-teal-900 mb-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="space-y-1">
        <strong class="font-bold flex items-center gap-1.5 text-teal-950">
          <span>⚖️</span> Nguyên tắc đối soát minh bạch (Nghị định 93/2021/NĐ-CP):
        </strong>
        <p class="text-teal-800/90 leading-relaxed text-[11px]">
          Chỉ phê duyệt sau khi đối chiếu khớp số tiền, nội dung chuyển khoản với sao kê tài khoản ngân hàng thực tế của bé hoặc bệnh viện. Khi bấm [Duyệt], hệ thống sẽ tự động tạo mã chứng nhận điện tử và mã QR xác thực công khai.
        </p>
      </div>
    </div>

    <!-- Donations List -->
    {{#if donations.length}}
      <div class="space-y-4">
        {{#each donations}}
          <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6 transition-all hover:border-slate-300">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
              
              <!-- Left: Donor & Child Info -->
              <div class="space-y-3 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-200">
                    Chờ Đối Soát
                  </span>
                  <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-700">
                    {{#if this.is_anonymous}}Ẩn Danh Ngoài Công Khai{{else}}Công Khai Tên{{/if}}
                  </span>
                  <span class="text-[11px] text-slate-400">
                    Gửi lúc: {{formatDate this.created_at}}
                  </span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
                  <div>
                    <span class="text-slate-400 block">Nhà hảo tâm:</span>
                    <strong class="text-slate-900 text-sm">{{this.donor_name}}</strong>
                    {{#if this.donor_phone}}
                      <div class="text-[11px] text-slate-500 font-mono">SĐT: {{this.donor_phone}}</div>
                    {{/if}}
                    {{#if this.donor_email}}
                      <div class="text-[11px] text-slate-500">Email: {{this.donor_email}}</div>
                    {{/if}}
                  </div>

                  <div>
                    <span class="text-slate-400 block">Ủng hộ cho bé:</span>
                    <a href="/warriors/{{this.child_slug}}" target="_blank" class="text-rose-600 font-bold hover:underline">
                      {{this.child_name}} {{#if this.child_nickname}}({{this.child_nickname}}){{/if}}
                    </a>
                    <div class="text-[11px] text-slate-500">
                      🏥 {{this.organization_name}}
                    </div>
                  </div>

                  <div>
                    <span class="text-slate-400 block">Số tiền chuyển:</span>
                    <strong class="text-emerald-700 font-extrabold text-base font-mono">
                      {{formatMoney this.amount}}
                    </strong>
                    <div class="text-[11px] text-slate-500">Phương thức: {{this.payment_method}}</div>
                  </div>
                </div>

                {{#if this.transfer_message}}
                  <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-700 italic">
                    "{{this.transfer_message}}"
                  </div>
                {{/if}}
              </div>

              <!-- Middle: Proof Screenshot Thumbnail (Zoomable) -->
              <div class="shrink-0 flex flex-col items-center">
                {{#if this.proof_image_url}}
                  <a
                    href="{{this.proof_image_url}}"
                    target="_blank"
                    title="Nhấn để xem ảnh phóng to"
                    class="group relative block w-28 h-28 rounded-xl overflow-hidden border-2 border-slate-200 bg-slate-100 shadow-inner"
                  >
                    <img
                      src="{{this.proof_image_url}}"
                      alt="Minh chứng giao dịch"
                      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-200"
                    />
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-[10px] font-bold">
                      🔍 Phóng to
                    </div>
                  </a>
                  <span class="text-[10px] text-slate-400 mt-1">Ảnh minh chứng</span>
                {{else}}
                  <div class="w-28 h-28 rounded-xl border border-dashed border-slate-300 flex flex-col items-center justify-center text-slate-400 text-[10px] p-2 text-center bg-slate-50">
                    <span>Không có ảnh</span>
                  </div>
                {{/if}}
              </div>

              <!-- Right: Action Buttons -->
              <div class="flex flex-row lg:flex-col gap-2 shrink-0 justify-end">
                <!-- Verify Button -->
                <form action="/donations/{{this.id}}/verify" method="POST" onsubmit="return confirm('Bạn xác nhận khoản tiền đã vào tài khoản và đồng ý cấp Chứng Nhận Tri Ân Số?')">
                  <button
                    type="submit"
                    class="w-full inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 shadow-sm transition-all"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>Duyệt & Cấp Chứng Nhận</span>
                  </button>
                </form>

                <!-- Reject Button (Toggle Form) -->
                <button
                  type="button"
                  onclick="document.getElementById('reject-box-{{this.id}}').classList.toggle('hidden')"
                  class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 transition-all"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                  <span>Từ chối</span>
                </button>
              </div>

            </div>

            <!-- Hidden Reject Reason Input Box -->
            <div id="reject-box-{{this.id}}" class="hidden mt-4 pt-4 border-t border-slate-100">
              <form action="/donations/{{this.id}}/reject" method="POST" class="flex flex-col sm:flex-row gap-2">
                <input
                  type="text"
                  name="reason"
                  placeholder="Nhập lý do từ chối (ví dụ: Không tìm thấy giao dịch trên sao kê, biên lai mờ...)"
                  required
                  class="flex-1 px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:ring-2 focus:ring-rose-500"
                />
                <button
                  type="submit"
                  class="px-4 py-2 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-lg shrink-0 transition-all"
                >
                  Xác nhận từ chối
                </button>
              </form>
            </div>

          </div>
        {{/each}}
      </div>
    {{else}}
      <div class="bg-white rounded-3xl border border-slate-200 p-12 text-center shadow-sm">
        <div class="w-16 h-16 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-3 text-2xl">
          ✨
        </div>
        <h3 class="text-base font-bold text-slate-800 mb-1">Hiện không có biên lai nào chờ duyệt</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          Tất cả các giao dịch ủng hộ đã được đối soát hoặc chưa có minh chứng mới gửi lên.
        </p>
      </div>
    {{/if}}

  </div>
</div>
