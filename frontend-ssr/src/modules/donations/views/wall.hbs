<div class="space-y-6">
  <!-- Header / Breadcrumbs -->
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
        <a href="/" class="hover:text-slate-900 transition-colors">Trang chủ</a>
        <span>/</span>
        <span class="text-slate-900 font-semibold">Bức Tường Vinh Danh Toàn Quốc</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 flex items-center gap-2.5">
        <span>🏆</span> Bức Tường Vinh Danh & Tri Ân Toàn Quốc
      </h1>
      <p class="text-sm text-slate-500 mt-1">
        Tri ân những tấm lòng nhân ái đã đồng hành, tiếp sức viện phí và thắp sáng hy vọng cho các chiến binh nhí.
      </p>
    </div>

    <!-- Badge Pháp lý minh bạch -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border border-emerald-200 bg-emerald-50 text-emerald-800 text-xs font-semibold shrink-0">
      <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
      </svg>
      <span>Minh bạch theo Nghị định 93/2021/NĐ-CP</span>
    </div>
  </div>

  <!-- Thống kê tổng quan vinh danh (Hero Metrics) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs font-medium text-slate-500">Tổng Viện Phí Đã Tiếp Sức</div>
      <div class="mt-2 text-2xl font-extrabold text-rose-600 font-mono">{{formatMoney totalAmount}}</div>
      <div class="mt-1 text-[11px] text-slate-400">Đã đối soát & giải ngân trực tiếp</div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs font-medium text-slate-500">Lượt Ủng Hộ Đã Xác Minh</div>
      <div class="mt-2 text-2xl font-extrabold text-slate-900">{{totalDonations}} lượt</div>
      <div class="mt-1 text-[11px] text-slate-400">Được cấp Chứng Nhận Số kèm QR</div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-xs font-medium text-slate-500">Chiến Binh Nhí Nhận Hỗ Trợ</div>
      <div class="mt-2 text-2xl font-extrabold text-emerald-600">{{totalChildrenSupported}} bé</div>
      <div class="mt-1 text-[11px] text-emerald-600/80">Tại các bệnh viện tuyến đầu</div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-gradient-to-br from-slate-900 to-slate-800 text-white p-5 shadow-sm">
      <div class="text-xs font-medium text-slate-300">Cơ Chế Giải Ngân</div>
      <div class="mt-2 text-base font-bold text-amber-300">Zero-touch Cashflow</div>
      <div class="mt-1 text-[11px] text-slate-300 leading-tight">100% tiền chuyển thẳng vào STK Bệnh viện & Gia đình</div>
    </div>
  </div>

  <!-- Phân bổ theo Bệnh viện & Quỹ (Hospital Breakdown) -->
  {{#if hospitalStats.length}}
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center gap-1.5">
        <span>🏥</span> Phân Bổ Tiếp Sức Theo Cơ Sở Điều Trị
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        {{#each hospitalStats}}
          <div class="rounded-lg border border-slate-100 bg-slate-50/70 p-3.5 flex items-center justify-between">
            <div class="min-w-0 pr-2">
              <div class="font-bold text-slate-900 text-xs truncate">{{this.name}}</div>
              <div class="text-[11px] text-slate-500 mt-0.5">{{this.province}} &bull; {{this.donation_count}} lượt ủng hộ</div>
            </div>
            <div class="text-right shrink-0">
              <div class="font-bold text-xs text-rose-600 font-mono">{{formatMoney this.total_amount}}</div>
            </div>
          </div>
        {{/each}}
      </div>
    </div>
  {{/if}}

  <!-- Bộ lọc theo Bệnh viện -->
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div class="flex items-center gap-2">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Lọc theo cơ sở:</span>
      <form method="GET" action="/wall-of-honor" class="inline-block">
        <select name="organization_id" onchange="this.form.submit()" class="h-8 rounded-lg border border-slate-200 bg-white px-2.5 text-xs font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-slate-900">
          <option value="">Tất cả các bệnh viện & quỹ</option>
          {{#each organizations}}
            <option value="{{this.id}}" {{#if (eq ../currentOrgId this.id)}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
      </form>
    </div>

    <!-- Quick action -->
    <button 
      type="button" 
      onclick="openGlobalSandboxModal()" 
      class="inline-flex items-center gap-1.5 text-xs font-semibold bg-rose-600 hover:bg-rose-700 text-white px-3 py-1.5 rounded-lg shadow-sm transition-all hover:scale-[1.02]"
    >
      <span>⚡</span> Mô phỏng ủng hộ (Sandbox 1-Click)
    </button>
  </div>

  <!-- Danh sách Giao dịch Vinh Danh (Feed List) -->
  {{#if donations.length}}
    <div class="space-y-3">
      {{#each donations}}
        <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5 shadow-sm hover:shadow-md transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <!-- Thông tin nhà hảo tâm & bé nhận -->
          <div class="flex items-start gap-3.5 min-w-0">
            <!-- Icon Huy chương vinh danh -->
            <div class="h-10 w-10 rounded-full bg-gradient-to-tr from-amber-400 to-rose-400 flex items-center justify-center text-white text-base shadow-sm shrink-0">
              🎖️
            </div>

            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-bold text-slate-900 text-sm">{{this.donor_name}}</span>
                <span class="text-slate-400 text-xs">&rarr;</span>
                <a href="/warriors/{{this.child_slug}}" class="inline-flex items-center gap-1 text-xs font-semibold text-rose-600 hover:underline">
                  <span>tiếp sức bé {{this.child_name}}</span>
                </a>
              </div>

              {{#if this.transfer_message}}
                <p class="text-xs text-slate-600 mt-1 italic line-clamp-2">
                  "{{this.transfer_message}}"
                </p>
              {{/if}}

              <div class="flex items-center gap-3 text-[11px] text-slate-400 mt-2 flex-wrap">
                <span>{{formatDate this.verified_at}}</span>
                <span>&bull;</span>
                <span class="font-mono text-slate-500">Mã GD: {{this.transaction_code}}</span>
                {{#if this.org_name}}
                  <span>&bull;</span>
                  <span class="text-slate-600">{{this.org_name}}</span>
                {{/if}}
              </div>
            </div>
          </div>

          <!-- Số tiền & Chứng nhận số -->
          <div class="flex items-center sm:flex-col sm:items-end justify-between sm:justify-center gap-2 shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-slate-100">
            <div class="text-right">
              <div class="text-base font-bold text-rose-600 font-mono">+{{formatMoney this.amount}}</div>
              <div class="text-[10px] text-emerald-600 font-semibold flex items-center justify-end gap-1">
                <svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                Đã xác minh
              </div>
            </div>

            {{#if this.certificate_qr_token}}
              <a 
                href="/verify/cert/{{this.certificate_qr_token}}" 
                target="_blank"
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-indigo-200 bg-indigo-50/70 hover:bg-indigo-100 text-indigo-900 text-xs font-medium transition-colors"
                title="Xem chứng nhận tri ân số"
              >
                <span>📜</span> Chứng Nhận Số
              </a>
            {{/if}}
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="rounded-xl border border-slate-200 bg-white p-12 text-center shadow-sm">
      <div class="w-12 h-12 rounded-full bg-slate-100 text-slate-400 mx-auto flex items-center justify-center text-xl mb-3">
        🏆
      </div>
      <h3 class="font-bold text-slate-800">Chưa có giao dịch nào được xác minh</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
        Hiện chưa có giao dịch nào được phê duyệt cho bộ lọc này. Bạn có thể sử dụng cổng Sandbox để mô phỏng ủng hộ ngay!
      </p>
      <button 
        type="button" 
        onclick="openGlobalSandboxModal()" 
        class="mt-4 inline-flex items-center text-xs font-bold bg-rose-600 hover:bg-rose-700 text-white px-4 py-2 rounded-lg shadow-sm transition-all"
      >
        Mở Cổng Mô Phỏng Sandbox 1-Click
      </button>
    </div>
  {{/if}}
</div>
