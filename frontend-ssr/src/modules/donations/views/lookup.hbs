<div class="space-y-6">
  <!-- Header / Breadcrumbs -->
  <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center gap-2 text-xs font-medium text-slate-500 mb-1">
        <a href="/" class="hover:text-slate-900 transition-colors">Trang chủ</a>
        <span>/</span>
        <a href="/wall-of-honor" class="hover:text-slate-900 transition-colors">Vinh danh</a>
        <span>/</span>
        <span class="text-slate-900 font-semibold">Tra Cứu Chứng Nhận Số</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 flex items-center gap-2.5">
        <span>📜</span> Cổng Tra Cứu Chứng Nhận Tri Ân Số
      </h1>
      <p class="text-sm text-slate-500 mt-1">
        Xác minh tính pháp lý và nguồn gốc minh bạch của các khoản tiếp sức theo quy định Nghị định 93/2021/NĐ-CP.
      </p>
    </div>
  </div>

  <!-- Search Card (shadcn/ui Card style) -->
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <form method="GET" action="/donations/lookup" class="space-y-4">
      <div>
        <label for="code" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
          Nhập Mã Chứng Nhận, Mã QR Token Hoặc Mã Giao Dịch:
        </label>
        <div class="flex flex-col sm:flex-row items-stretch gap-2">
          <div class="relative flex-1">
            <input 
              type="text" 
              id="code" 
              name="code" 
              value="{{searchCode}}" 
              required
              placeholder="Ví dụ: CERT-2026-NHI-00145 hoặc qr-minhan-cert-001" 
              class="h-11 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 text-sm font-mono text-slate-900 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-slate-900"
            />
          </div>
          <button 
            type="submit" 
            class="h-11 px-6 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow-sm transition-all hover:scale-[1.01] shrink-0"
          >
            🔍 Tra Cứu Ngay
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Kết quả tra cứu nếu có -->
  {{#if certResult}}
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50/40 p-6 shadow-sm space-y-4">
      <div class="flex items-center justify-between flex-wrap gap-2 pb-3 border-b border-emerald-100">
        <div class="flex items-center gap-2 text-emerald-800 font-bold text-sm">
          <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span>CHỨNG NHẬN HỢP LỆ & ĐÃ ĐỐI SOÁT THÀNH CÔNG</span>
        </div>
        <span class="text-xs font-mono font-bold text-emerald-700 bg-emerald-100 px-3 py-1 rounded-full">
          {{certResult.certificate_code}}
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs">
        <div class="bg-white p-3.5 rounded-xl border border-emerald-100">
          <span class="text-slate-400 block text-[10px] uppercase font-bold">Nhà Hảo Tâm</span>
          <span class="font-bold text-slate-900 text-sm mt-0.5 block">{{certResult.donor_name}}</span>
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-emerald-100">
          <span class="text-slate-400 block text-[10px] uppercase font-bold">Chiến Binh Nhí Nhận Tiếp Sức</span>
          <a href="/warriors/{{certResult.child_slug}}" class="font-bold text-rose-600 hover:underline text-sm mt-0.5 block">
            {{certResult.child_name}}
          </a>
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-emerald-100">
          <span class="text-slate-400 block text-[10px] uppercase font-bold">Số Tiền Viện Phí</span>
          <span class="font-extrabold text-rose-600 text-sm mt-0.5 block font-mono">{{formatMoney certResult.amount}}</span>
        </div>
        <div class="bg-white p-3.5 rounded-xl border border-emerald-100">
          <span class="text-slate-400 block text-[10px] uppercase font-bold">Cơ Sở Y Tế Bảo Trợ</span>
          <span class="font-bold text-slate-900 text-xs mt-0.5 block truncate">{{certResult.organization_name}}</span>
        </div>
      </div>

      <div class="flex items-center justify-between flex-wrap gap-3 pt-2">
        <div class="text-[11px] text-slate-500">
          Thời gian xác minh: <strong>{{formatDate certResult.verified_at}}</strong> &bull; Người đối soát: <strong>{{#if certResult.verifier_name}}{{certResult.verifier_name}}{{else}}Ban Quản Trị Hệ Thống{{/if}}</strong>
        </div>
        <a 
          href="/verify/cert/{{certResult.certificate_qr_token}}" 
          target="_blank"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold shadow-sm transition-all hover:scale-[1.01]"
        >
          <span>📜</span> Mở Bản In Chứng Nhận Toàn Màn Hình &rarr;
        </a>
      </div>
    </div>
  {{/if}}

  {{#if notFound}}
    <div class="rounded-2xl border border-rose-200 bg-rose-50/50 p-6 text-center shadow-sm">
      <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 mx-auto flex items-center justify-center text-xl mb-3">
        ⚠️
      </div>
      <h3 class="font-bold text-slate-900 text-sm">Không tìm thấy chứng nhận với mã đã nhập</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
        Mã tra cứu "{{searchCode}}" không trùng khớp với bất kỳ chứng nhận nào đã phát hành trên hệ thống.
      </p>
    </div>
  {{/if}}

  <!-- Danh sách chứng nhận đã phát hành gần đây (1-Click Sample Lookup) -->
  <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
      <div>
        <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
          <span>🌟</span> Chứng Nhận Tri Ân Đã Phát Hành Gần Đây
        </h3>
        <p class="text-xs text-slate-500 mt-0.5">Nhấp vào mã bất kỳ bên dưới để tra cứu hoặc xem chi tiết chứng nhận</p>
      </div>
      <span class="text-xs font-mono bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full">
        Live Certificates
      </span>
    </div>

    {{#if recentCerts.length}}
      <div class="divide-y divide-slate-100">
        {{#each recentCerts}}
          <div class="py-3 flex items-center justify-between flex-wrap gap-2 group hover:bg-slate-50/80 -mx-3 px-3 rounded-lg transition-colors">
            <div class="flex items-center gap-3 min-w-0">
              <div class="h-8 w-8 rounded-lg bg-indigo-50 border border-indigo-100 text-indigo-700 flex items-center justify-center text-xs shrink-0 font-bold font-mono">
                QR
              </div>
              <div class="min-w-0">
                <a 
                  href="/donations/lookup?code={{this.certificate_code}}"
                  class="font-mono text-xs font-bold text-indigo-600 hover:underline block truncate"
                  title="Tra cứu mã này"
                >
                  {{this.certificate_code}}
                </a>
                <p class="text-[11px] text-slate-500 truncate mt-0.5">
                  <span class="font-medium text-slate-800">{{this.donor_name}}</span> &bull; Tiếp sức bé <strong class="text-rose-600">{{this.child_name}}</strong> ({{this.org_name}})
                </p>
              </div>
            </div>

            <div class="flex items-center gap-3 shrink-0">
              <span class="font-mono text-xs font-bold text-slate-900">{{formatMoney this.amount}}</span>
              <a 
                href="/verify/cert/{{this.certificate_qr_token}}" 
                target="_blank"
                class="px-2.5 py-1 rounded-lg border border-slate-200 bg-white hover:bg-slate-100 text-slate-700 text-xs font-medium transition-colors"
              >
                Xem Bản Gốc 📜
              </a>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="text-xs text-slate-400 py-4 text-center">Chưa có chứng nhận nào trong hệ thống.</p>
    {{/if}}
  </div>

  <!-- Note Pháp lý -->
  <div class="rounded-xl border border-slate-200/80 bg-slate-50 p-4 text-xs text-slate-600 leading-relaxed">
    🛡️ <strong>Nguyên tắc minh bạch & toàn vẹn dữ liệu:</strong> Mỗi Chứng Nhận Tri Ân Số được cấp đều mang một mã nhận diện băm độc bản (QR Hash Token) và liên kết trực tiếp với sao kê ngân hàng đã đối soát bởi Bệnh viện hoặc Ban Điều phối. Người ủng hộ và cộng đồng có thể quét mã QR bằng camera điện thoại tại bất kỳ đâu mà không cần cài đặt thêm ứng dụng.
  </div>
</div>
