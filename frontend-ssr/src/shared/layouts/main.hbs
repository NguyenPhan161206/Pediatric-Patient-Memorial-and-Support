<!DOCTYPE html>
<html lang="vi" class="h-full bg-slate-50">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{#if title}}{{title}} | {{/if}}Chiến Binh Nhí - Cổng Ký Ức & Tri Ân</title>
  
  <!-- OpenGraph Dynamic Meta Tags cho chia sẻ MXH -->
  <meta property="og:title" content="{{#if title}}{{title}}{{else}}Chiến Binh Nhí - Courageous Little Warriors Hub{{/if}}">
  <meta property="og:description" content="{{#if description}}{{description}}{{else}}Cổng lưu trữ, tri ân và vinh danh hành trình kiên cường của các bệnh nhi ung thư/hiểm nghèo.{{/if}}">
  <meta property="og:type" content="website">
  {{#if ogImage}}<meta property="og:image" content="{{ogImage}}">{{/if}}

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <!-- TailwindCSS via CDN (Cấu hình chuẩn màu sắc shadcn/ui) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            border: "hsl(214.3 31.8% 91.4%)",
            background: "hsl(0 0% 100%)",
            foreground: "hsl(222.2 84% 4.9%)",
            muted: {
              DEFAULT: "hsl(210 40% 96.1%)",
              foreground: "hsl(215.4 16.3% 46.9%)",
            },
            accent: {
              DEFAULT: "hsl(210 40% 96.1%)",
              foreground: "hsl(222.2 47.4% 11.2%)",
            },
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
      width: 5px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #e2e8f0;
      border-radius: 9999px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: #cbd5e1;
    }
  </style>
</head>
<body class="min-h-full bg-slate-50 text-slate-900 antialiased selection:bg-rose-500 selection:text-white">
  
  <!-- Modern App Shell Layout (Left Sidebar Toolbar + Main Canvas) -->
  <div class="min-h-screen flex">
    
    <!-- Left Sidebar Toolbar (App Shell Left Rail) -->
    {{> sidebar }}

    <!-- Right Canvas (Topbar + Body + Footer) -->
    <div class="flex-1 flex flex-col min-w-0 min-h-screen overflow-x-hidden">
      
      <!-- Topbar Header -->
      {{> navbar }}

      <!-- Main Content Area -->
      <main class="flex-1">
        {{{body}}}
      </main>

      <!-- Footer -->
      {{> footer }}
      
    </div>

  </div>

</body>
</html>
