<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Logo & Slogan -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="h-9 w-9 rounded-lg bg-gradient-to-tr from-rose-500 to-amber-400 flex items-center justify-center text-white shadow-sm shadow-rose-200 group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <div>
          <span class="font-bold text-slate-900 tracking-tight text-base sm:text-lg block leading-none">Chiến Binh Nhí</span>
          <span class="text-[11px] text-slate-500 font-medium">Courageous Warriors Hub</span>
        </div>
      </a>
    </div>

    <!-- Navigation links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
      <a href="/" class="transition-colors hover:text-slate-900">Trang chủ</a>
      <a href="/warriors" class="transition-colors hover:text-slate-900 font-semibold text-rose-600">Hồ sơ các bé</a>
      
      {{#if currentUser}}
        {{#if (eq currentUser.role "FAMILY")}}
          <a href="/family/portal" class="transition-colors hover:text-slate-900 flex items-center gap-1.5 text-amber-700 font-medium">
            <span>👨‍👩‍👧</span> Cổng Gia Đình
          </a>
        {{/if}}
        {{#if (or (eq currentUser.role "ADMIN") (eq currentUser.role "SUPER_ADMIN") (eq currentUser.role "COORDINATOR") (eq currentUser.role "ORG_ADMIN"))}}
          <a href="/tributes/moderation" class="transition-colors hover:text-slate-900 flex items-center gap-1.5 text-indigo-700 font-medium">
            <span>🛡️</span> Duyệt Lời Chúc
          </a>
        {{/if}}
      {{/if}}
      
      <a href="/#system-health" class="transition-colors hover:text-slate-900">Kiến trúc 3-Tier</a>
    </nav>

    <!-- Actions / Auth Buttons (Dynamic User State) -->
    <div class="flex items-center gap-3">
      {{#if currentUser}}
        <!-- Đã đăng nhập: Hiện Avatar/Tên + Role Badge + Đăng xuất -->
        <div class="flex items-center gap-3">
          <div class="hidden sm:flex flex-col text-right">
            <span class="text-xs font-bold text-slate-900 leading-tight">{{currentUser.fullName}}</span>
            <span class="text-[10px] uppercase font-semibold tracking-wider 
              {{#if (or (eq currentUser.role "ADMIN") (eq currentUser.role "SUPER_ADMIN"))}}text-rose-600
              {{else if (eq currentUser.role "ORG_ADMIN")}}text-teal-600
              {{else if (eq currentUser.role "FAMILY")}}text-amber-600
              {{else if (eq currentUser.role "COORDINATOR")}}text-indigo-600
              {{else}}text-slate-500{{/if}}">
              {{#if (eq currentUser.role "ORG_ADMIN")}}ADMIN BỆNH VIỆN{{else}}{{currentUser.role}}{{/if}}
            </span>
          </div>

          <a href="/auth/logout" class="inline-flex items-center justify-center text-xs font-medium text-slate-600 hover:text-rose-600 border border-slate-200 hover:border-rose-200 hover:bg-rose-50 h-9 px-3 rounded-md transition-colors">
            Đăng xuất
          </a>
        </div>
      {{else}}
        <!-- Chưa đăng nhập: Hiện nút Login & Register -->
        <a href="/auth/login" class="inline-flex items-center justify-center text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-100/80 h-9 px-3.5 rounded-md transition-colors">
          Đăng nhập
        </a>
        <a href="/auth/register" class="inline-flex items-center justify-center text-sm font-medium bg-slate-900 text-slate-50 hover:bg-slate-800 h-9 px-4 rounded-md shadow-sm transition-all hover:shadow">
          Đăng ký
        </a>
      {{/if}}
    </div>
  </div>
</header>
