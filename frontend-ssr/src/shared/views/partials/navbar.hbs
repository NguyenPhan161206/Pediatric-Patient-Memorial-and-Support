<header class="sticky top-0 z-30 w-full border-b border-slate-200/80 bg-white/80 backdrop-blur-md">
  <div class="px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    
    <!-- Left: Mobile Hamburger Toggle + Breadcrumbs -->
    <div class="flex items-center gap-3">
      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        onclick="toggleSidebar(true)"
        class="lg:hidden p-2 rounded-xl text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors focus:outline-none"
        title="Mở thanh công cụ"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-medium text-slate-500">
        <a href="/" class="hover:text-slate-900 transition-colors flex items-center gap-1">
          <span>🏠</span>
          <span class="hidden sm:inline">Trang Chủ</span>
        </a>
        {{#if title}}
          <span>/</span>
          <span class="text-slate-900 font-semibold truncate max-w-[200px] sm:max-w-md">{{title}}</span>
        {{/if}}
      </nav>
    </div>

    <!-- Right: Quick Actions, 3-Tier Status & Auth State -->
    <div class="flex items-center gap-3">
      
      <!-- System 3-Tier Quick Badge -->
      <a
        href="/#system-health"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 transition-colors"
        title="Hệ thống 3 tầng Decoupled Architecture hoạt động ổn định"
      >
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Hệ Thống 3 Tầng: Online</span>
      </a>

      <!-- Quick Demo Shortcut Button -->
      <button
        type="button"
        onclick="openGlobalSandboxModal()"
        class="hidden md:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-extrabold text-amber-900 bg-amber-100/80 hover:bg-amber-200 border border-amber-300 shadow-xs transition-all active:scale-95 cursor-pointer"
      >
        <span>⚡</span>
        <span>Thử Nghiệm Demo</span>
      </button>

      <!-- Auth State / User Profile -->
      {{#if currentUser}}
        <div class="flex items-center gap-2.5 pl-2 sm:border-l border-slate-200">
          <div class="h-8 w-8 rounded-lg bg-gradient-to-tr from-rose-500 to-amber-500 text-white font-bold text-xs flex items-center justify-center shrink-0 shadow-sm">
            {{currentUser.fullName.[0]}}
          </div>
          <div class="hidden md:flex flex-col text-left">
            <span class="text-xs font-bold text-slate-900 leading-tight">{{formatDisplayName currentUser}}</span>
            <span class="text-[9px] uppercase font-bold tracking-wider
              {{#if (or (eq currentUser.role "ADMIN") (eq currentUser.role "SUPER_ADMIN"))}}text-rose-600
              {{else if (eq currentUser.role "ORG_ADMIN")}}text-teal-600
              {{else if (eq currentUser.role "FAMILY")}}text-amber-600
              {{else if (eq currentUser.role "COORDINATOR")}}text-indigo-600
              {{else}}text-slate-500{{/if}}">
              {{#if (eq currentUser.role "ORG_ADMIN")}}ADMIN BỆNH VIỆN{{else}}{{currentUser.role}}{{/if}}
            </span>
          </div>
          <a
            href="/auth/logout"
            class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors"
            title="Đăng xuất"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
          </a>
        </div>
      {{else}}
        <div class="flex items-center gap-2">
          <a
            href="/auth/login"
            class="inline-flex items-center justify-center text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-100 h-8 px-3 rounded-lg transition-colors"
          >
            Đăng nhập
          </a>
          <a
            href="/auth/register"
            class="inline-flex items-center justify-center text-xs font-bold bg-slate-900 text-white hover:bg-slate-800 h-8 px-3 rounded-lg shadow-sm transition-all"
          >
            Đăng ký
          </a>
        </div>
      {{/if}}

    </div>

  </div>
</header>
